TQ36zIPtw533.png"},"siteUrl":"https://anilist.co/character/396516"},"role":"SUPPORTING"},{"id":571835,"node":{"id":396517,"isFavourite":false,"gender":"Female","age":"28","dateOfBirth":{"day":15,"month":7},"name":{"full":"Rin Mamiya","native":"間宮凛"},"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b396517-U6Igw2kjLbjo.png"},"siteUrl":"https://anilist.co/character/396517"},"role":"SUPPORTING"},{"id":571828,"node":{"id":396510,"isFavourite":false,"gender":"Female","age":"15","dateOfBirth":{"day":31,"month":10},"name":{"full":"Imari Agano","native":"吾野伊万里"},"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b396510-lWldOZwgoXqs.png"},"siteUrl":"https://anilist.co/character/396510"},"role":"SUPPORTING"},{"id":580867,"node":{"id":403442,"isFavourite":false,"dateOfBirth":{},"name":{"full":"Nanami Kou","native":"皇七海"},"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/default.jpg"},"siteUrl":"https://anilist.co/character/403442"},"role":"SUPPORTING"},{"id":571829,"node":{"id":396511,"isFavourite":false,"gender":"Female","age":"15","dateOfBirth":{"day":15,"month":8},"name":{"full":"Isuzu Ikazuchi","native":"五十土五十鈴"},"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b396511-iOrWtdn4zWhz.png"},"siteUrl":"https://anilist.co/character/396511"},"role":"SUPPORTING"},{"id":580868,"node":{"id":403443,"isFavourite":false,"gender":"Male","dateOfBirth":{},"name":{"full":"Black Lotus","native":"ブラックロータス"},"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b403443-SbUjdzSzRVxf.png"},"description":"[Mizuka](https://anilist.co/character/396508/)'s father. The former ringmaster of the legendary circus \"Lotus Circus\" that every circus performer aspires to join. As a father, he drilled circus techniques into Mizuka. Currently, he is wandering somewhere in the world.","siteUrl":"https://anilist.co/character/403443"},"role":"SUPPORTING"},{"id":571830,"node":{"id":396512,"isFavourite":false,"gender":"Female","age":"15","dateOfBirth":{"day":20,"month":3},"name":{"full":"Aoi Yura","native":"由良葵"},"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b396512-hujovgf1txww.png"},"siteUrl":"https://anilist.co/character/396512"},"role":"SUPPORTING"},{"id":580873,"node":{"id":403471,"isFavourite":false,"gender":"Male","dateOfBirth":{},"name":{"full":"Black Lotus","native":"ブラックロータス"},"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/default.jpg"},"siteUrl":"https://anilist.co/character/403471"},"role":"SUPPORTING"},{"id":571831,"node":{"id":396513,"isFavourite":false,"gender":"Female","age":"15","dateOfBirth":{"day":20,"month":3},"name":{"full":"Akane Yura","native":"由良茜"},"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b396513-Azczc5xexBEY.png"},"siteUrl":"https://anilist.co/character/396513"},"role":"SUPPORTING"},{"id":571832,"node":{"id":396514,"isFavourite":false,"gender":"Female","age":"21","dateOfBirth":{"day":30,"month":11},"name":{"full":"Shizuku Sakawa","native":"酒匂雫"},"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b396514-i1iY7cEMivHM.png"},"siteUrl":"https://anilist.co/character/396514"},"role":"SUPPORTING"},{"id":571833,"node":{"id":396515,"isFavourite":false,"gender":"Female","age":"20","dateOfBirth":{"day":21,"month":3},"name":{"full":"Svetlana","native":"スヴェトラーナ"},"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b396515-y2cowBgs03B5.png"},"siteUrl":"https://anilist.co/character/396515"},"role":"SUPPORTING"}]},"description":"The anime's story is set in the late 1950s and early 1960s, during the height of Japan's economic boom, when the circus is a major form of entertainment. Different circus troupes travel throughout Japan to perform and compete for a chance to participate in the world-renowned festival called \"Circus Collection.\" One troupe called the \"Sunflower Circus,\" led by its ringmaster Maria, travels around Japan to perform, despite struggling with financial difficulties. However, they meet a circus prodigy named Mizuka Tsurumaki. This is the story of a one-of-a-kind circus show of young girls with big dreams.\u003cbr\u003e\u003cbr\u003e\n(Source: Anime News Network)","duration":24,"endDate":{},"id":196017,"meanScore":72,"popularity":5569,"rankings":[{"allTime":false,"context":"highest rated","format":"TV","rank":85,"type":"RATED","year":2026},{"allTime":false,"context":"highest rated","format":"TV","rank":28,"season":"SUMMER","type":"RATED","year":2026}],"recommendations":{"edges":[{"node":{"mediaRecommendation":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/20602-HrakjBfgWeRg.jpg","coverImage":{"color":"#e4ae50","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx20602-f6CfipBF44kV.png","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx20602-f6CfipBF44kV.png","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx20602-f6CfipBF44kV.png"},"description":"When new transfer student Isuzu asks Seiya Kanie out on a date at gunpoint, he knows something odd is going on. Especially since she wants to go to Amagi Brilliant Park, where the rides are either dangerous or mind-numbingly dull and the only costumed performers who aren’t rude or apathetic are the ones who didn’t show up for work.\u003cbr\u003e\n\u003cbr\u003e\nSo when Isuzu asks Seiya to take over as the park’s new manager, he knows she’s crazy (Well, crazy-er, given the gunpoint thing.).  But when Seiya learns that Amagi Brilliant Park is a REAL Magic Kingdom, that the costumed performers aren’t wearing costumes, that they live off the energy created by attendees, and that unless they can attract 250,000 attendees in three months, they’ll lose their jobs and homes… he goes a little crazy himself.\u003cbr\u003e\n\u003cbr\u003e\nBut, even with the aid of scantily clad fairies, giant mice and sniper-trained sheep, can anyone rescue a park that’s sunk so low that its own bus doesn’t stop there anymore? The race is on to get the turnstiles turning and save Amagi Brilliant Park!\u003cbr\u003e\n\u003cbr\u003e\n(Source: Sentai Filmworks)","episodes":13,"format":"TV","id":20602,"idMal":22147,"isAdult":false,"meanScore":72,"season":"FALL","siteUrl":"https://anilist.co/anime/20602","startDate":{"day":7,"month":10,"year":2014},"status":"FINISHED","title":{"english":"Amagi Brilliant Park","native":"甘城ブリリアントパーク","romaji":"Amagi Brilliant Park","userPreferred":"Amagi Brilliant Park"},"trailer":{"id":"WGMLDSTkvDo","site":"youtube","thumbnail":"https://i.ytimg.com/vi/WGMLDSTkvDo/hqdefault.jpg"},"type":"ANIME"}}},{"node":{"mediaRecommendation":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/170891-4OuuElPLL20Q.jpg","coverImage":{"color":"#f1e4c9","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx170891-Bhxn5y4a86Q0.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx170891-Bhxn5y4a86Q0.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx170891-Bhxn5y4a86Q0.jpg"},"description":"Misora Kanata is a first-year student on the Takanosaki High School cheerleading team. She won a national championship in middle school, but can’t jump after a mistake in a competition. She befriends Suzuha, Shion, Anna, Nodoka, and Megumi to form the PoMPoMs. Their new team goes beyond cheerleading to reach the hearts of the people they cheer on. They might just change the world!\u003cbr\u003e\u003cbr\u003e\n(Source: Crunchyroll, edited)","episodes":12,"format":"TV","id":170891,"idMal":57099,"isAdult":false,"meanScore":61,"season":"SUMMER","siteUrl":"https://anilist.co/anime/170891","startDate":{"day":7,"month":7,"year":2024},"status":"FINISHED","title":{"english":"Narenare -Cheer for you!-","native":"菜なれ花なれ","romaji":"Na-Nare Hana-Nare","userPreferred":"Narenare -Cheer for you!-"},"trailer":{"id":"O2wKUAAra9E","site":"youtube","thumbnail":"https://i.ytimg.com/vi/O2wKUAAra9E/hqdefault.jpg"},"type":"ANIME"}}},{"node":{"mediaRecommendation":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/176246-Cnm6EqDLxEN3.jpg","coverImage":{"color":"#50bbe4","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx176246-ndH8bKh7cmzf.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx176246-ndH8bKh7cmzf.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx176246-ndH8bKh7cmzf.jpg"},"description":"Satsuki Amamiya was feeling down due to the graduation of the high school Photography Club’s president. However, her best friend and fellow member An Kiriyama encourages Satsuki to dedicate herself to the newly merged Cinephoto Club. Join Satsuki and An as they set out to track down a missing camera, meet new faces, and capture stunning photos and videos along the way. \u003cbr\u003e\u003cbr\u003e (Source: Crunchyroll)","episodes":12,"format":"TV","id":176246,"idMal":58492,"isAdult":false,"meanScore":76,"season":"SPRING","siteUrl":"https://anilist.co/anime/176246","startDate":{"day":13,"month":4,"year":2025},"status":"FINISHED","title":{"english":"mono","native":"mono","romaji":"mono","userPreferred":"mono"},"trailer":{"id":"YJzMiDd8RyM","site":"youtube","thumbnail":"https://i.ytimg.com/vi/YJzMiDd8RyM/hqdefault.jpg"},"type":"ANIME"}}},{"node":{"mediaRecommendation":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/427-JGvVUBiJTgWY.jpg","coverImage":{"color":"#5daef1","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx427-nzHOyyTX2jLO.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx427-nzHOyyTX2jLO.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx427-nzHOyyTX2jLO.jpg"},"description":"Sora, a young girl from Japan, comes to America in search of her dream. She wants, with all her heart, to be a member of the Kaleido Stage, a world famous circus, with a combination of musicals, acrobatics and magical effects. With the help of her friends, she struggles to make this dream come true.","episodes":51,"format":"TV","id":427,"idMal":427,"isAdult":false,"meanScore":76,"season":"SPRING","siteUrl":"https://anilist.co/anime/427","startDate":{"day":3,"month":4,"year":2003},"status":"FINISHED","title":{"english":"Kaleido Star","native":"カレイドスター","romaji":"Kaleido Star","userPreferred":"Kaleido Star"},"type":"ANIME"}}},{"node":{"mediaRecommendation":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/98658-YifB5qgBgnGQ.jpg","coverImage":{"color":"#50a1e4","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx98658-Xz8uliDO7dzZ.png","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx98658-Xz8uliDO7dzZ.png","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx98658-Xz8uliDO7dzZ.png"},"description":"The franchise centers on \"Starlight\" — the song and dance revue troupe loved throughout the world. Karen and Hikari make a promise with each other when they're young that one day they'll stand on that stage together. Time passes, and now the girls are 16 years old. Karen is very enthusiastic about the lessons she takes every day, holding her promise close to her heart. Hikari has transferred schools and is now away from Karen. But the cogs of fate turn, and the two are destined to meet again. The girls and other \"Stage Girls\" will compete in a mysterious audition process to gain acceptance into the revue.\n\u003cbr\u003e\u003cbr\u003e\n(Source: Anime News Network)","episodes":12,"format":"TV","id":98658,"idMal":35503,"isAdult":false,"meanScore":77,"season":"SUMMER","siteUrl":"https://anilist.co/anime/98658","startDate":{"day":13,"month":7,"year":2018},"status":"FINISHED","title":{"english":"Revue Starlight","native":"少女☆歌劇 レヴュー・スタァライト","romaji":"Shoujo☆Kageki Revue Starlight","userPreferred":"Revue Starlight"},"trailer":{"id":"ZLvkR2n92N4","site":"youtube","thumbnail":"https://i.ytimg.com/vi/ZLvkR2n92N4/hqdefault.jpg"},"type":"ANIME"}}},{"node":{"mediaRecommendation":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/122807-WuQXmiTg70lh.jpg","coverImage":{"color":"#e4a128","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx122807-m8jdQLQRSSUI.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx122807-m8jdQLQRSSUI.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx122807-m8jdQLQRSSUI.jpg"},"description":"Joutarou Aragaki, former member of the national team, had given his whole life for gymnastics and was fighting against his age and physical strength. However, one day he is told by his coach to start thinking of his next career. Joutarou struggles, but his daughter, Rei, is always there by his side. But with one fateful encounter, the Aragakis’ lives change drastically.\n\u003cbr\u003e\u003cbr\u003e\n(Source: Funimation)\n","episodes":11,"format":"TV","id":122807,"idMal":42668,"isAdult":false,"meanScore":70,"season":"FALL","siteUrl":"https://anilist.co/anime/122807","startDate":{"day":11,"month":10,"year":2020},"status":"FINISHED","title":{"english":"The Gymnastics Samurai","native":"体操ザムライ","romaji":"Taisou Zamurai","userPreferred":"The Gymnastics Samurai"},"trailer":{"id":"KSdkglUr7oc","site":"youtube","thumbnail":"https://i.ytimg.com/vi/KSdkglUr7oc/hqdefault.jpg"},"type":"ANIME"}}},{"node":{"mediaRecommendation":{"coverImage":{"color":"#e48650","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx188525-uWhw4rQcqOyF.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx188525-uWhw4rQcqOyF.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx188525-uWhw4rQcqOyF.jpg"},"description":"First-year high school student Ai Yasumi lives on the island of Izu Oshima and loves reading manga. But after a certain turning point, she sets her sights on creating stories of her own! As she dives into the world of manga-making, Ai faces challenges, growth, and the excitement of chasing her creative dreams. Where will her creative journey take her?\u003cbr\u003e\n\u003cbr\u003e\n(Source: Crunchyroll)","episodes":12,"format":"TV","id":188525,"idMal":61280,"isAdult":false,"meanScore":73,"season":"SUMMER","siteUrl":"https://anilist.co/anime/188525","startDate":{"day":3,"month":7,"year":2026},"status":"RELEASING","title":{"english":"Draw This, Then Die!","native":"これ描いて死ね","romaji":"Kore Kaite Shine","userPreferred":"Draw This, Then Die!"},"trailer":{"id":"jI61NtGuxV4","site":"youtube","thumbnail":"https://i.ytimg.com/vi/jI61NtGuxV4/hqdefault.jpg"},"type":"ANIME"}}},{"node":{"mediaRecommendation":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/n16035-9ecItBO7l3K2.jpg","coverImage":{"color":"#f1bb5d","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx16035-TAbW2i7rtXVM.png","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx16035-TAbW2i7rtXVM.png","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx16035-TAbW2i7rtXVM.png"},"description":"Armed with only an abandoned bracelet as a clue, Nai searches for a missing loved one. After a run-in with a pick-pocket named Gareki, the two find themselves snagged in a government set-up that leaves them both wanted criminals. Desperate and on the run, Nai and Gareki turn to the country’s most powerful defense organization—“Circus”—for help.\u003cbr\u003e\u003cbr\u003e\n(Source: Crunchyroll)","episodes":13,"format":"TV","id":16035,"idMal":16035,"isAdult":false,"meanScore":66,"season":"SPRING","siteUrl":"https://anilist.co/anime/16035","startDate":{"day":4,"month":4,"year":2013},"status":"FINISHED","title":{"english":"Karneval (TV)","native":"カーニヴァル (TV)","romaji":"Karneval (TV)","userPreferred":"Karneval (TV)"},"type":"ANIME"}}}]},"relations":{},"siteUrl":"https://anilist.co/anime/196017","staff":{"edges":[{"node":{"id":117231,"name":{"full":"Kurehito Misaki"}},"role":"Original Character Design"},{"node":{"id":102268,"name":{"full":"Kanta Kamei"}},"role":"Director "},{"node":{"id":157656,"name":{"full":"Satsuki Takahashi"}},"role":"Assistant Director"},{"node":{"id":218415,"name":{"full":"Takeshi Kikuchi"}},"role":"Series Composition"},{"node":{"id":140622,"name":{"full":"Kazutoshi Makino "}},"role":"Character Design"},{"node":{"id":306311,"name":{"full":"Takumi Hashimoto"}},"role":"Art Director"},{"node":{"id":145794,"name":{"full":"Eiko Tsunadou"}},"role":"Art Design"},{"node":{"id":164832,"name":{"full":"Kanako Hokari"}},"role":"Color Design"},{"node":{"id":146397,"name":{"full":"Toshiyuki Aoshima"}},"role":"Director of Photography"},{"node":{"id":145109,"name":{"full":"Kentarou Tsubone"}},"role":"Editing"},{"node":{"id":175140,"name":{"full":"Mizuho Kanda"}},"role":"CG Director"},{"node":{"id":118972,"name":{"full":"Akiko Fujita"}},"role":"Sound Director"},{"node":{"id":109287,"name":{"full":"Yuugo Kanno"}},"role":"Music "},{"node":{"id":218415,"name":{"full":"Takeshi Kikuchi"}},"role":"Script"},{"node":{"id":140622,"name":{"full":"Kazutoshi Makino "}},"role":"Chief Animation Director"},{"node":{"id":138091,"name":{"full":"Masaki Inada"}},"role":"Action Supervisor"},{"node":{"id":146672,"name":{"full":"Munashichi"}},"role":"Image Board"},{"node":{"id":230135,"name":{"full":"Mikiya Hiragi"}},"role":"Background Art Layout"},{"node":{"id":293403,"name":{"full":"Ayane Matsumoto"}},"role":"Effects Design"},{"node":{"id":293403,"name":{"full":"Ayane Matsumoto"}},"role":"Picture Book Design"},{"node":{"id":394408,"name":{"full":"Junko Yamada"}},"role":"Historical Research"},{"node":{"id":211457,"name":{"full":"Shouta Fujii"}},"role":"Animation Producer"},{"node":{"id":358176,"name":{"full":"Aooo"}},"role":"Theme Song Performance (ED)"},{"node":{"id":342602,"name":{"full":"NOMELON NOLEMON"}},"role":"Theme Song Performance (OP)"}]},"startDate":{"day":5,"month":7,"year":2026},"studios":{"nodes":[{"id":561,"name":"A-1 Pictures"},{"id":7682,"name":"Psyde Kick Studio"}]},"trailer":{"id":"PAneuhZLHzU","site":"youtube","thumbnail":"https://i.ytimg.com/vi/PAneuhZLHzU/hqdefault.jpg"}}},"updated_at":"2026-07-12T02:20:06.704883625+05:30"},"21":{"value":{"Media":{"averageScore":87,"characters":{"edges":[{"id":8805,"node":{"age":"17-","dateOfBirth":{"day":1,"month":4},"description":"__Height:__ 174 cm (5'8½\")\n__Affiliation:__ Straw Hat Pirates (previously Usopp Pirates)  \n__Position:__ Sniper  \n__Bounty:__  ~!500,000,000 (previously 30,000,000 as Sogeking, 200,000,000 as God Usopp)!~  \n \nUsopp is a liar and likes to play pranks on his crew members or just goof off with [Luffy](https://anilist.co/character/40/Luffy-Monkey) and [Chopper](https://anilist.co/character/309). He loves to tell tall tales to Chopper (who believes him blindly) or anyone who's listening. The other aspect of Usopp besides his lying is his cowardice; he is a very timid person, or so he thinks. In extremely stressful situations, Usopp has proven to be far more courageous than he believes himself to be. He shows great resolve when his friends are threatened or mocked by outsiders. Even though he is a complete coward in battle, he is a useful part to the Straw Hat Pirates. He is extremely handy and can fix almost anything. He sometimes sees a role model in [Zoro](https://anilist.co/character/62/Zoro-Roronoa) who never seems afraid but always proud. Usopp lacks a bit of self esteem and is often taken advantage of by [Nami](https://anilist.co/character/723) to make her weapons or repair and improve them - something he is very adept at, having constructed the ingenious weapon \"Clima Tact.\" \n\nUsopp will also stand up and fight for not only the well-being of people, but also for their ideals - and the ideals of a pirate, which he holds very high. In battle he normally tries to trick his enemy by telling tales or mischievous lies to deceive them. Despite his lack of physical strength compared to other members of the crew, Usopp seems to be just as resilient as his comrades and this ability to bear loads and loads of damage, is one of his best traits, in addition to his cunning and intelligence, which has saved the Straw Hats on many occasions. Usopp also has outstanding marksmanship abilities with his slingshot and is on his way to becoming one of the best snipers in the One Piece world, although his goal in life is to become a proud and strong pirate like his father [Yasopp](https://anilist.co/character/9562/Yasopp) of the Red Haired Pirate Crew.","gender":"Male","id":724,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b724-GFGgI9AJQkfy.jpg"},"isFavourite":false,"name":{"alternative":["Long-Nose","Usohachi","Usoland","Sogeking","Lysop"],"full":"Usopp","native":"ウソップ"},"siteUrl":"https://anilist.co/character/724"},"role":"MAIN"},{"id":14989,"node":{"age":"19-","dateOfBirth":{"day":11,"month":11},"description":"__Height:__ 178 cm (5'10\")\n__Affiliation:__ ~!Straw Hat Pirates (current); Kuraigane Island (former, temporary); Shimotsuki Village (former)!~\n__Bounty:__  ~!1,111,000,000 (previously: 60,000,000, 120,000,000 and 320,000,000)!~\n\nZoro was the first crew member to be recruited by [Luffy](https://anilist.co/character/40/Luffy-Monkey). \n\nZoro is a skilled swordsman who fights with his own unique sword style known as santoryu (three katana fighting style). This is achieved by using one katana in each hand, and another in his mouth. He is also seen fighting with only one or two swords. When in a serious fight he ties his normally, tied on the arm bandana, on his head. Though not a samurai, he appears to maintain a certain degree of bushido, and is frequently mistaken for one. Unlike Luffy and most of the other Straw Hat pirates, Zoro has been known to kill his opponents if he has to, though never in cold blood. \n\nZoro has a stern, serious and distanced personality, however he often reacts in a goofy and exaggerated comic style due to his gruff, impatient attitude. On the ship, he normally either trains with weights or sleeps. The only work he is seen doing regularly is hoisting the anchor using his great strength. He also likes sake, almost to the degree that Luffy likes meat, but like [Nami](https://anilist.co/character/723/Nami), he never gets drunk due to his inhumanly-high endurance and tolerance for alcohol. Another notable trait is his lack of orientation, as Zoro often gets lost, even in small, familiar spaces or when being led by someone. Despite this, he is often the first to sense an enemy or danger, and the first to react. He is often displayed being well aware of dangerous situations and people around him.  \n\nZoro often reminds others of the harsh facts, which often shocks some of the other crew members, although they usually decide he is right. Zoro has also stated that he is an atheist, and has never believed in anything except himself. He often comes across as arrogant and overconfident, but only because he knows he's a strong man with great fighting ability. Even so, Zoro knows that he still has a lot of untapped potential, and is constantly seen training and trying to improve his fighting skills. He adheres to a strict sword master's code of honor, and never falsely brags or lies about his abilities, sometimes outright admitting a weakness, even to an enemy. He also never tries to escape from a fight or use trickery to win, believing that doing so is cowardly and scorning anyone who uses such tactics. Zoro is very vigorous, strong-willed, and determined.","gender":"Male","id":62,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b62-S7oAeA9WInjV.png"},"isFavourite":false,"name":{"alternative":["Zolo","Pirate Hunter","Marimo Head","Mr. Bushido","Zorojuro","Moss Head","Lorenor Zorro"],"full":"Zoro Roronoa","native":"ロロノア・ゾロ"},"siteUrl":"https://anilist.co/character/62"},"role":"MAIN"},{"id":15397,"node":{"age":"15-","dateOfBirth":{"day":24,"month":12},"description":"__Height:__ 90 cm (2'11¼\")\n__Affiliation:__ Straw Hat Pirates\n__Position:__  Doctor\n__Devil Fruit:__ Hito Hito no Mi (Human Human Fruit)\n__Devil Fruit Type:__ Zoan\n__Bounty:__ ~!1,000 (previously; 50 and 100)!~\n\nChopper is the 6th member to join the Straw Hat Pirates, acting as their general physician, despite being a reindeer. \n\nAfter a set of unusual circumstances, he ate the Hito Hito no Mi (Human Human Fruit), which permitted him the ability to speak, think, and (to a limited extent) change into a human. Chopper often acts like a child, but he is an upright friend and companion who will try anything to overcome a task given by his team. He also still has distrust in humankind because of events his youth, where he was treated as a brutal monster. He will often outright insult a human who compliments him while smiling, dancing, and being obviously pleased. He also shows a certain interest in books, but mostly medicine related ones. Chopper is more or less on a journey to define himself, seeing almost anybody on his crew as a role model. This, combined with his naiveness, often causes him to imitate the other Straw Hats' actions, no matter how obviously silly. Because of this, he often gets involved in the crazy antics of [Luffy](https://anilist.co/character/40/Luffy-Monkey) and [Usopp](https://anilist.co/character/724/Usopp), wholeheartedly believing that what they are doing is sensible and fun. \n\nChopper is one of the most innocent Straw Hat Pirates, and is also very naive, resulting in a tendency to believe anything told to him, even the outrageously fictitious and exaggerated lies of Usopp. [Sanji](https://anilist.co/character/305/Sanji) originally wanted to cook Chopper and continues to refer to him as \"the emergency food supply\" to tease him but considers him a friend. Although he is the crew's doctor, he wasn't originally hired by Luffy for that purpose, but rather, in Luffy's words, for being  \"a cool reindeer that can transform\".","gender":"Male","id":309,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b309-H64NhbJ2ywIQ.jpg"},"isFavourite":false,"name":{"alternative":["Tanuki","Chopperman","Cotton Candy Lover","Racoon Dog","Chobro","Chopa-emon  (チョッパえもん)","Chopperemon"],"full":"Chopper Tony Tony","native":"トニートニー・チョッパー"},"siteUrl":"https://anilist.co/character/309"},"role":"MAIN"},{"id":9778,"node":{"age":"18-","dateOfBirth":{"day":3,"month":7},"description":"__Height:__ 169 cm (5'6½”)\n__Affiliation:__ Straw Hat Pirates\n__Position:__  Navigator\n__Bounty:__  ~!366,000,000 (previously; 16,000,000 and 66,000,000)!~\n\nNami is the third person to align herself with Straw Hat Pirates, and the fifth to actually join as an official member. Possibly one of the best navigators currently sailing the Grand Line, she has the ability to recognize and analyze even the slightest changes in the weather through sheer intuition, thus saving the ship and the crew from the very unstable Grand Line weather on multiple occasions.  ","gender":"Female","id":723,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b723-vp5hPptgnNEC.png"},"isFavourite":false,"name":{"alternative":["Cat Burglar","O-Nami","Namizo","Namiland"],"full":"Nami","native":"ナミ"},"siteUrl":"https://anilist.co/character/723"},"role":"MAIN"},{"id":15676,"node":{"age":"28-","dateOfBirth":{"day":6,"month":2},"description":"__Height:__ 188 cm (6'2\")\n__Affiliation:__ ~!Straw Hat Pirates (Current); Baltigo (Revolutionaries, Former, Temporary); Alabasta (Baroque Works, Former); Ohara (Former)!~\n__Position:__ Archaeologist\n__Devil Fruit:__  ~!Hana Hana no Mi (Flower Flower Fruit)!~\n__Devil Fruit Type:__ ~!Paramecia!~\n__Bounty:__ ~!930,000,000 (previously; 79,000,000, 80,000,000 and 130,000,000)!~\n\nRobin is the seventh member of Straw Hat's Crew. She had a bounty of 79 million beri (One Piece currency) since she was eight years old, during an incident in which she supposedly destroyed six Buster Call ships through the use of the powers she gained by eating the Hana Hana no Mi (Flower Flower or Blooming Blooming Fruit). The fruit's power enables her to conjure up multiple replicas of her body parts (most often her arms) upon any surface she is able to see making her very powerful and dexterous as a result. Robin joined the Straw Hat Pirates after [Luffy](https://anilist.co/character/40) saved her life, or (how she states it) Luffy forced her to live when she wanted to die. To atone for his crime, Robin demands that Luffy allow her to join his crew, to which he complies leaving every other crew member except [Sanji](https://anilist.co/character/305) in shock. Although feared at first, she is quickly accepted and viewed as a comrade by the crew.\n\nRobin is actually an archaeologist of talent and despises anyone who thoughtlessly damages any piece of history. The World Government fears her because she can decipher Poneglyphs (stones marked with glyphs from an ancient language), which contain details capable of reviving ancient weapons that have the power to destroy the world. In reality, Robin has stated that she does not care about ancient weapons and that her dream is to find the True History written on the Rio Poneglyph.\n\nRobin is a mysterious and serious person who appears quiet and reclusive, and the wisest in the Straw Hat's Crew. She was thought by those around her to be cold and mean, but it was proven that she is actually a kind person who always thinks before she acts. She often only speaks when something interesting or important has happened. She loves to study history, and the comfort and freedom to study and read. She is also quick to point out gross or realistically morbid facts, often creeping out [Nami](https://anilist.co/character/723) or [Usopp](https://anilist.co/character/724). Robin is the wisest and most sensible member of the crew. She has a vast knowledge of the seas and the world and usually keeps her head during surprising situations, allowing her to logically analyze the situation without losing her cool. This trait makes her different from the other Straw Hats, who often comically react melodramatically to unexpected happenings and hold irrational ideas and conclusions. Despite her attempts to keep herself distant, Robin has fallen for her new friends and has taken the role of the distant den mother.","gender":"Female","id":61,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b61-ywXUyyocEEqt.png"},"isFavourite":false,"name":{"alternative":["Demon Child","Miss All Sunday","Light of the Revolution","O-Robi","Robiland","Ms. Sunday","Devil Child"],"full":"Robin Nico","native":"ニコロビン"},"siteUrl":"https://anilist.co/character/61"},"role":"MAIN"},{"id":9680,"node":{"age":"17-","dateOfBirth":{"day":5,"month":5},"description":"__Height:__ 172 cm\n__Affiliations:__ ~!Straw Hat Pirates (Captain); Four Emperors!~ \n__Devil Fruit:__ Gomu Gomu no Mi (Rubber-Rubber Fruit) \n__Devil Fruit Type:__ Paramecia\n~!__True Devil Fruit:__ Hito Hito no Mi Model: Nika (Human-Human Fruit)\n__True Devil Fruit Type:__ Mythical Zoan!~\n__Bounty:__ ~!3,000,000,000 (previously: 1,500,000,000, 500,000,000, 400,000,000, 300,000,000, 100,000,000 and 30,000,000)!~\n\nLuffy is the captain of the Straw Hat Pirates and is best friends with all of them and values them over all else. At first glance, Luffy does not appear to be very intelligent, often seeing things in childish manner and can easily be amazed by the simplest things. However, because he views the world in a straightforward and simple manner, he is occasionally the only person who can see past the events and see what should be done.  \n\nLuffy seems to have an unstoppable appetite, a characteristic that is common to the Japanese archetype of the (at times simple-minded) young adventurer with a heart of gold; perhaps the hunger more so in Luffy's case due to having an elastic stomach. Luffy is also another one of the several characters given the middle initial \"D\".  \n\nAlthough Luffy is fairly lightheaded and a funny character, he has an unstoppable sense of determination, optimism and commitment and will do anything to stand up for his friends and comrades. Along with that, he has great courage to back it up as well as unbelievable strength. Ever since consuming the devil fruit he was shown to be not worried about his inability to swim, much like his brother. Much of these traits are common among D's. His only display of true fear is towards his grandfather, to the point that he does not fight back and is intimidated at the mere mention of him.  \n\nLuffy never kills any of the villains, no matter how cold-hearted they are; instead, he frequently sends the villain flying, knocking them out or until the point that they are almost near death, which results in some of the villains searching for revenge, such as [Buggy the Clown](https://anilist.co/character/725) and [Alvida](https://anilist.co/character/4899). Author [Eiichiro Oda](https://anilist.co/staff/96881) explains that it's not a question of morality so much as a matter of punishing the villains for their crimes - he feels that killing the villains lets them off too lightly, whereas he considers letting them live to see their dreams be ruined a far more fitting punishment.  \n\nLuffy has a dream, and to even have a chance at achieving this dream, he says that he must find the One Piece and become King of the Pirates. He knows that to achieve his goal, he will have to defeat many strong opponents, including the World Government and his childhood hero [Shanks](https://anilist.co/character/727). ","gender":"Male","id":40,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b40-MNypXsxSRb1R.png"},"isFavourite":false,"name":{"alternative":["Straw Hat","Mugiwara","Straw","Mugi","Lucy","Luffyland","Mugiwara no Luffy","Mugiwara-ya","Ruffy","Monkey D. Rufy","Rufy","Rubber"],"full":"Luffy Monkey","native":"モンキー・D・ルフィ"},"siteUrl":"https://anilist.co/character/40"},"role":"MAIN"},{"id":15189,"node":{"age":"19-","dateOfBirth":{"day":2,"month":3},"description":"__Height:__ 177 cm (5'9\")\n__Affiliation:__ ~!Straw Hat Pirates (current); Momoiro Island (former, temporary); Baratie (former); Germa Kingdom (former)!~\n__Bounty:__ ~!1,032,000,000 (previously; 77,000,000, 177,000,000 (Only Alive) and 330,000,000)!~\n\nSanji is the chain-smoking chef of the Straw Hat Pirate Crew. He has superb fighting skills that only make use of his legs, in an effort to minimize damage to his hands which would impair his cooking skills. Sanji uses an array of powerful and varied kicking moves when he fights. His cooking skills are world class, and he was mentored in both cooking and fighting by Chef \"Red Leg\" Zeff of the Baratie. He was born in the North Blue, but grew up in the East Blue. Sanji is trash-talking and serious, and usually gruff and impatient, especially around men. This is contrasted by his \"love-cook\" side, as he is very amorous around women. Sanji is completely devoted to any beautiful woman, usually losing all common sense and composure in front of them, then attempting to comically swoon them. He has sworn to never let insult or injury happen to any woman while he can still stand, even if that woman is trying to kill him. This is often problematic in his fighting as he can't attack female opponents, and would rather die than hurt them. All this is apparently the result of a \"strict upbringing\".\n\nHis goal in life is to find the All Blue, a legendary ocean, which contains all the fish in the world. As such, it would be paradise for any cook with as much love for his work as Sanji, who holds great respect for the tools, ingredients, and art of cooking. So great is his devotion to his calling, that Sanji will not let any person or creature starve, regardless of them being friend or foe.  Being the crew's chef, he looks out for the health of his crew mates. Sanji respects [Luffy](https://anilist.co/character/40) as a captain, but often gets angry at him for eating too much, showing disrespect for the aesthetics of cooking, and generally being daft and irresponsible. He is constantly in petty fights with [Zoro](https://anilist.co/character/62) (sometimes calling him Marimo) over each others' traits and they have developed a rivalry, but have managed to make a devastating team together. He is very protective of the female crew members and [Nami](https://anilist.co/character/723) likes to take advantage of him, exploiting his extreme servility. Sanji originally wanted to cook [Chopper](https://anilist.co/character/309), but has come to respect him as a crew member and friend. He's also good friends with [Usopp](https://anilist.co/character/724); they team up and interact often, and Sanji understands him quite well. ","gender":"Male","id":305,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b305-6lisPmHtCnLT.png"},"isFavourite":false,"name":{"alternative":["Black Leg","Mr. Prince","Love Cook","Ero Cook","Curly Eyebrows","O-Soba Mask","Sangoro","Mr. Nosebleed","San-gorou"],"full":"Sanji","native":"サンジ"},"siteUrl":"https://anilist.co/character/305"},"role":"MAIN"},{"id":15769,"node":{"age":"34-","dateOfBirth":{"day":9,"month":3},"description":"__Height:__ 225cm (7'4½\")\n__Affiliation:__ Straw Hat Pirates (previously; Franky Family, Tom's Workers)\n__Position:__ Shipwright\n__Devil Fruit:__ None\n__Bounty:__  ~!394,000,000 (previously; 44,000,000 and 94,000,000)!~\n\nFranky is a cyborg who is the shipwright of the Straw Hat Pirates. He first appeared in the Water 7 arc. Franky is one of \"Tom's Workers\".  Franky's dream is to build a ship that would travel to the end of the Grand Line. This is the ship that the Straw Hats are currently riding, but his dream is not yet achieved until they make it to the end.  Franky usually acts tough and is quickly angered, but he is also very emotional when it comes to sad tales and often bursts into large tears, or on some occasions, plays a song. His most distinguishable personality trait is his flamboyant attitude. He frequently shouts the word 'SUPER' when he's in a positive mood, or adds it into his speech. He also has a signature pose which he uses very often.  Franky is quick to defend other people (eg. Franky Family, Nico Robin) and take action if his friends are harmed. He is also quick in making friends, allies, and comrades with even the most unlikely of individuals. Because of this, he is seen as a 'big brother' figure. Monkey D. Luffy bears similar qualities (with the exception of engaging in unnecessary fights) and because of this, despite the disputes the two had in the past, both grew to respect each other during the events of the Enies Lobby Arc.","gender":"Male","id":64,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/n64-ChX6ZzHHjXqA.png"},"isFavourite":false,"name":{"alternative":["Cyborg","Bakanky","Iron Man","Fraland","Franosuke","Frankie"],"full":"Franky","native":"フランキー"},"siteUrl":"https://anilist.co/character/64"},"role":"MAIN"},{"id":45118,"node":{"age":"44-","dateOfBirth":{"day":2,"month":4},"description":"__Height:__ 301 cm (9'10½\")\n__Affiliation:__ ~!Straw Hat Pirates (current); Sun Pirates (former); Ally of the Big Mom Pirates (former); Shichibukai (former); Ryugu Kingdom (resigned); Impel Down (former)]!~\n__Position:__ ~!Captain (Sun Pirates), Helmsman (Straw Hat Pirates)!~\n__Devil Fruit:__ None\n__Bounty:__ ~!1,100,000,000 (previously; 250,000,000, 76,000,000 and 438,000,000)!~\n\nJinbe is a whale shark fishman who was the second captain of the Sunny Pirates after Fisher Tiger, and who became a Shichibukai eight years ago. Jinbe's name comes from jinbei-zame (甚平鮫), which means \"whale shark\" in Japanese. His epithet, Kaikyou would normally translate into \"Strait\" or \"Channel\". However since the kanji for it is written as (海侠の) and not (海峡の), the kyou part (侠) of it comes from (任侠), a honorific used when addressing a high ranking yakuza member, thus making his epithet a Japanese pun.\n\n(Source: One Piece Wikia) ","gender":"Male","id":18938,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b18938-yZANEfjsVhW4.png"},"isFavourite":false,"name":{"alternative":["Kaikyou no Jinbe","Knight of the Sea","First Son of the Sea","Jimbei","Jinbei","Jinbee","Boss Jinbe"],"full":"Jinbe","native":"ジンベエ"},"siteUrl":"https://anilist.co/character/18938"},"role":"MAIN"},{"id":49630,"node":{"age":"88-","dateOfBirth":{"day":3,"month":4},"description":"__Height:__ 266 cm (8'8½\")\n__Affiliation:__ Straw Hat Pirates (previously; Rumbar Pirates)\n__Position:__ Musician, Swordsman\n__Devil Fruit:__ Yomi Yomi no Mi (Revive Revive Fruit)\n__Devil Fruit Type:__ Paramecia\n__Bounty:__  ~!383,000,000 (previously; 33,000,000 and 83,000,000)!~\n\nBrook known as the \"Gentleman Skeleton\", is a pirate inhabiting the Florian Triangle region of the Grand Line. Although he claims to be a gentleman, and talks in the dialect of one, Brook's etiquette has severely degenerated over the course of his isolation. He has awful table manners: he shouts for food while waiting to be served, asks to swap plates with people who have larger servings than he does and eating so messily his entire face is stained. He is also extremely flatulent after meals, but says \"excuse me\" so as to be \"gentlemanly.\" He also loves to tell odd, bone-themed jokes, as well as melodramatic tales, and is very perverted, asking to see Nami and Robin's underwear upon meeting them.   He's a skilled musician (something Luffy has always wanted in his crew since the beginning), fond of playing the violin. Due to his light weight he can not only jump to incredible heights but can run on water by moving his legs furiously. He uses a shikomizue as his main weapon; with it, he is able to make swift iaidō attacks that the enemy cannot notice.","gender":"Male","id":5627,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b5627-av8oD3zhKvDl.png"},"isFavourite":false,"name":{"alternative":["Dead Bones","Soul King","Satan-sama","Boneland","Honekichi","Bonekichi","The Starving Skeleton","Humming Brook"],"full":"Brook","native":"ブルック"},"siteUrl":"https://anilist.co/character/5627"},"role":"MAIN"},{"id":1057,"node":{"age":"28","dateOfBirth":{"day":2,"month":6},"description":"__Height:__ 212 cm (6'11½\")\n__Affiliation:__ Galley-La Company ~!CP9 (former); CP-0!~__Devil Fruit:__ Neko Neko no Mi, Model: Leopard (Cat-Cat Fruit Leopard Model)\n__Devil Fruit Type:__ Zoan \n\nWhen Lucci is first seen as one of the five foremen of Galley-La Company's Dock One, he appears to be a ventriloquist using his pigeon, [Hattori](https://anilist.co/character/147149/Hattori), to speak for him. He also shows very impressive skills when he gets into a fight with [Paulie](https://anilist.co/character/8503/Paulie) and, later on, [Luffy](https://anilist.co/character/40/Monkey-D-Luffy). \n\n~!It is soon revealed he is the unquestioned leader of the Water 7 CP9 unit which infiltrated the Galley-La company, and perfectly capable of speaking for himself. Lucci ate the Neko Neko no Mi, Model: Leopard (ネコネコの実 モデル豹(レオパルド), Cat Cat Fruit, Model: Leopard ), which allows him to turn into a huge leopard-human hybrid and a full leopard. This coupled with his mastered martial arts style of rokushiki, makes him a resilient foe, and he has been ranked as the strongest CP9 agent by far. Lucci can perform Life Return, like [Kumadori](https://anilist.co/character/4784/Kumadori), and use it to alter his body into forms that amplify his skills in a specific rokushiki ability, though only Kami-e Form, which makes his man-beast form smaller and thinner, has been seen and arguably the main villain of the Enies Lobby Arc if not the main threat to the Straw Hats at the time.!~ ","gender":"Male","id":5677,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b5677-ZrZunVe7Kq5P.png"},"isFavourite":false,"name":{"alternative":["Pigeon Guy"],"full":"Lucci Rob","native":"ロブ･ルッチ"},"siteUrl":"https://anilist.co/character/5677"},"role":"SUPPORTING"},{"id":3712,"node":{"age":"39","dateOfBirth":{"day":4,"month":10},"description":"__Debut:__ Chapter 286; Episode 187 \n__Height:__ 222 cm (7'3\")\n__Origin:__ Grand Line\n\nCalgara was a hero and a warrior of the Shandians who lived while Upper Yard was still a part of Jaya (some 400 years ago), and who befriended the explorer Montblanc Norland (the ancestor of Montblanc Cricket). A statue of him was erected after his death as an eternal reminder to the Shandians of his strength and courage. He had a daughter named Musse. Wiper is a direct descendant of his.    Calgara was quick to react and a strong believer in traditions of his people. He was hugely mistrusting of strangers. Calgara's personality changed after he met Norland with many of his outtakes of the world changing alongside it. One particular note was that after seeing his God for what it truly was (a giant snake), he dismisses all Gods including the Skypieans \u0026quot;God\u0026quot;.","gender":"Male","id":17190,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/n17190-BCsc92WDAZPs.png"},"isFavourite":false,"name":{"alternative":["Karugara","Kalgara","Shandora's Demon"],"full":"Calgara","native":"カルガラ"},"siteUrl":"https://anilist.co/character/17190"},"role":"SUPPORTING"},{"id":6680,"node":{"dateOfBirth":{},"description":"Whetton is a character in the One Piece Rainbow Mist filler arc. He is a former pirate, who burned down Ruluka and then became its mayor, because he yearned for safety and power. He later funds Henzo\u0026#039;s research, by putting up silly and exorbitant taxes, to complete the construction of the Rainbow Tower, so as to get access to the Rainbow Mist\u0026#039;s treasures. \n\n(Source: One Piece Wikia)","id":33569,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/33569.jpg"},"isFavourite":false,"name":{"alternative":["Mayor"],"full":"Whetton","native":"ウェットン"},"siteUrl":"https://anilist.co/character/33569"},"role":"SUPPORTING"},{"id":9775,"node":{"dateOfBirth":{"day":1,"month":8},"description":"__Affiliations:__ Kuja Pirates\n\nAphelandra is a member of a tribe of Kuja living on the island of Amazon Lily. She is large-sized human who accompanied Marguerite and Sweet Pea when they found Luffy covered in mushrooms. Despite her size, Aphelandra has shown to be rather timid, often repeating what others have said to her as she obeys their command. She is a kind and innocent woman.\n\n","gender":"Female","id":21541,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b21541-Dkm9rWSYxyJE.png"},"isFavourite":false,"name":{"full":"Aphelandra","native":"アフェランドラ"},"siteUrl":"https://anilist.co/character/21541"},"role":"SUPPORTING"},{"id":10432,"node":{"age":"24-","dateOfBirth":{"day":27,"month":1},"description":"__Height:__ 215 cm (7'0½\")\n__Affiliation:__ Rolling Pirates ~!Charlotte Family!~\n__Bounty:__ ~!24,000,000!~\n\nThe original Lola is a female pirate who is the captain of the Rolling Pirates. She is a member of a group of Moria's victims who have banded together, the Thriller Bark Victim's Association.\n~!She is one of the daughters of Big Mom and her father is Linlin's 25th husband, Pound. She is the younger twin sister of Chiffon!~","gender":"Female","id":35834,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b35834-oKYQTV6tORQT.jpg"},"isFavourite":false,"name":{"alternative":["Marriage Proposal Lola"],"full":"Lola","native":"ローラ"},"siteUrl":"https://anilist.co/character/35834"},"role":"SUPPORTING"},{"id":13460,"node":{"dateOfBirth":{"day":14,"month":1},"description":"Sweet Pea (スイトピー, Suitopī?) is a member of a tribe of Kuja living on the island of Amazon Lily. She was first seen accompanying Marguerite and Aphelandra when they found the mushroom covered Luffy. \n\n(Source: One Piece Wikia)","gender":"Female","id":21540,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b21540-WpdEYB6NddiO.png"},"isFavourite":false,"name":{"full":"Sweet Pea","native":"スイトピー"},"siteUrl":"https://anilist.co/character/21540"},"role":"SUPPORTING"},{"id":14987,"node":{"dateOfBirth":{},"description":"__First Appearance:__ Chapter 161; Episode 96   \n\nThe Kung-Fu Dugongs are a type of Dugong living in Arabasta that is famous for their martial arts skills and strength. Their code of honor states that once they are defeated, a Dugong must become the follower of the one who defeated them. Their code extends to any 'disciples' their master may have with him as well. Currently, their master is Luffy as he unwittingly defeated them all. They live in the Sandora River.  \n\n(Source: One Piece Wikia)","id":18784,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/18784.jpg"},"isFavourite":false,"name":{"full":"Kung Fu Dugong","native":"クンフージュゴン"},"siteUrl":"https://anilist.co/character/18784"},"role":"SUPPORTING"},{"id":15394,"node":{"dateOfBirth":{},"description":"Enishida (エニシダ, Enishida?) is a member of the Kuja. One of Hancock's attendants in her castle. ","id":21544,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b21544-SUgpMDh6isaf.png"},"isFavourite":false,"name":{"full":"Enishida","native":"エニシダ"},"siteUrl":"https://anilist.co/character/21544"},"role":"SUPPORTING"},{"id":15770,"node":{"age":"30","dateOfBirth":{"day":9,"month":1},"description":"__Debut:__ Chapter 598; Episode 517 \n__Affiliations:__ Fake Straw Hat Crew \n__Height:__ 294 cm (9'7\") \n\nMounblutain was a member of the Fake Straw Hat Crew who masqueraded as [Sogeking](https://anilist.co/character/724/Usopp).","gender":"Male","id":49821,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b49821-5e0vEA3UME87.jpg"},"isFavourite":false,"name":{"alternative":["Fake Sogeking"],"full":"Mounblutain","native":"マウンブルテン"},"siteUrl":"https://anilist.co/character/49821"},"role":"SUPPORTING"},{"id":16745,"node":{"age":"16","dateOfBirth":{"day":4,"month":4},"description":"__First Appearance:__ Chapter 612 \n\nA giant smelt-whiting mermaid and the youngest of [King Neptune](https://anilist.co/character/40271)'s children. She was first mentioned by [Pappug](https://anilist.co/character/19311), who claimed he knew her and even promised to introduce her to the Straw Hat Pirates when they arrived at Fishman Island (though later this is revealed to be a lie). ~!She is the Ancient Weapon Poseidon.!~ ","gender":"Female","id":40273,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/40273.jpg"},"isFavourite":false,"name":{"alternative":["Mermaid Princess","Yowahoshi"],"full":"Shirahoshi","native":"しらほし"},"siteUrl":"https://anilist.co/character/40273"},"role":"SUPPORTING"},{"id":18435,"node":{"age":"27","dateOfBirth":{"day":11,"month":4},"description":"Pekoms is a combatant of the Big Mom Pirates. He is partnered with Tamago, and both are responsible for collecting the monthly payment of sweets from Fishman Island in exchange for Big Mom's protection.   First Appearance: Chapter 651   ~!Bounty: 330,000,000.!~  (source: One Piece Wikia)","gender":"Male","id":54499,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b54499-1Bb8NfHH07Kj.jpg"},"isFavourite":false,"name":{"alternative":["Pecoms","Mystoms"],"full":"Pekoms","native":"ペコムズ"},"siteUrl":"https://anilist.co/character/54499"},"role":"SUPPORTING"},{"id":19868,"node":{"dateOfBirth":{},"description":"Spandam is the leader of CP9, and the former leader of CP5. As the leader of CP5 he attempted to retrieve the blueprints of the weapon Pluton from the shipwright Tom. He failed, though Tom was imprisoned as a result of Spandam's actions. As the leader of CP9, he ordered the capture of Franky and Nico Robin, and had them taken to Enies Lobby. Spandam is defeated by Nico Robin, who breaks his back while the Straw Hat crew flee the Bridge of Hesitation. He owns a sword, \u0026quot;Funk Freed\u0026quot; (ファンクフリード Fankufurīdo), which \u0026quot;ate\u0026quot; the Devil Fruit, Zou Zou no Mi (ゾウゾウの実 Elephant Elephant Fruit), giving it the ability to transform into an elephant.    Source: Wikipedia","id":6551,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b6551-szpvKXmtWqGX.png"},"isFavourite":false,"name":{"full":"Spandam","native":"スパンダム"},"siteUrl":"https://anilist.co/character/6551"},"role":"SUPPORTING"},{"id":21209,"node":{"dateOfBirth":{},"description":"Zeo is a Japanese wobbegong shark fishman and an officer of the New Fishman Pirates.  First Appearance: Chapter 611  (source: One Piece Wikia)","id":40276,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b40276-cDrb69UzdEbp.jpg"},"isFavourite":false,"name":{"full":"Zeo","native":"ゼオ"},"siteUrl":"https://anilist.co/character/40276"},"role":"SUPPORTING"},{"id":22886,"node":{"age":"66","dateOfBirth":{"day":22,"month":12},"description":"**First Appearance:** Chapter 237; Episode 153\n\nGan Fall, is the current, two time God of Skypiea.","gender":"Male","id":22798,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b22798-2DOxtVP5YtfT.png"},"isFavourite":false,"name":{"alternative":["Sky Knight","Ganfall","Ganfor","Gunfall","Gan Fooru","Sora no Kishi (空の騎士)","Knight of the Sky","Sky Lord"],"full":"Gan Fall","native":"ガン・フォール"},"siteUrl":"https://anilist.co/character/22798"},"role":"SUPPORTING"},{"id":24017,"node":{"age":"24","dateOfBirth":{"day":4,"month":2},"description":"__Height:__ 604 cm (19’10”)\n__Affiliation:__ Neptune Family\n\nFukaboshi is a shark merman and also the first son of the royal Neptune family on Fishman Island.\n\n","gender":"Male","id":40264,"image":{"large":"https://s4.anilist.co/file/anilistcdn/character/large/b40264-jSwDS1UM0nOF.jpg"},"isFavourite":false,"name":{"full":"Fukaboshi","native":"フカボシ"},"siteUrl":"https://anilist.co/character/40264"},"role":"SUPPORTING"}]},"description":"Gold Roger was known as the Pirate King, the strongest and most infamous being to have sailed the Grand Line. The capture and death of Roger by the World Government brought a change throughout the world. His last words before his death revealed the location of the greatest treasure in the world, One Piece. It was this revelation that brought about the Grand Age of Pirates, men who dreamed of finding One Piece (which promises an unlimited amount of riches and fame), and quite possibly the most coveted of titles for the person who found it, the title of the Pirate King.\u003cbr\u003e\u003cbr\u003e\nEnter Monkey D. Luffy, a 17-year-old boy that defies your standard definition of a pirate. Rather than the popular persona of a wicked, hardened, toothless pirate who ransacks villages for fun, Luffy’s reason for being a pirate is one of pure wonder; the thought of an exciting adventure and meeting new and intriguing people, along with finding One Piece, are his reasons of becoming a pirate. Following in the footsteps of his childhood hero, Luffy and his crew travel across the Grand Line, experiencing crazy adventures, unveiling dark mysteries and battling strong enemies, all in order to reach One Piece.\u003cbr\u003e\u003cbr\u003e\n\u003cb\u003e*This includes the following special episodes:\u003c/b\u003e\u003cbr\u003e\n- Chopperman to the Rescue! Protect the TV Station by the Shore! (Episode 336)\u003cbr\u003e\n- The Strongest Tag-Team! Luffy and Toriko's Hard Struggle! (Episode 492)\u003cbr\u003e\n- Team Formation! Save Chopper (Episode 542)\u003cbr\u003e\n- History's Strongest Collaboration vs. Glutton of the Sea (Episode 590)\u003cbr\u003e\n- 20th Anniversary! Special Romance Dawn (Episode 907)","duration":24,"endDate":{},"genres":["Action","Adventure","Comedy","Drama","Fantasy"],"id":21,"meanScore":87,"popularity":715422,"rankings":[{"allTime":true,"context":"highest rated all time","format":"TV","rank":26,"type":"RATED"},{"allTime":true,"context":"most popular all time","format":"TV","rank":8,"type":"POPULAR"},{"allTime":false,"context":"highest rated","format":"TV","rank":1,"type":"RATED","year":1999},{"allTime":false,"context":"most popular","format":"TV","rank":1,"type":"POPULAR","year":1999}],"recommendations":{"edges":[{"node":{"mediaRecommendation":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/11061-8WkkTZ6duKpq.jpg","coverImage":{"color":"#f1d65d","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx11061-y5gsT1hoHuHw.png","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx11061-y5gsT1hoHuHw.png","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx11061-y5gsT1hoHuHw.png"},"description":"A new adaption of the manga of the same name by Togashi Yoshihiro.\u003cbr\u003e\u003cbr\u003e\nA Hunter is one who travels the world doing all sorts of dangerous tasks. From capturing criminals to searching deep within uncharted lands for any lost treasures. Gon is a young boy whose father disappeared long ago, being a Hunter. He believes if he could also follow his father's path, he could one day reunite with him.\u003cbr\u003e\u003cbr\u003e\nAfter becoming 12, Gon leaves his home and takes on the task of entering the Hunter exam, notorious for its low success rate and high probability of death to become an official Hunter. He befriends the revenge-driven Kurapika, the doctor-to-be Leorio and the rebellious ex-assassin Killua in the exam, with their friendship prevailing throughout the many trials and threats they come upon taking on the dangerous career of a Hunter.","episodes":148,"format":"TV","id":11061,"idMal":11061,"isAdult":false,"meanScore":89,"season":"FALL","siteUrl":"https://anilist.co/anime/11061","startDate":{"day":2,"month":10,"year":2011},"status":"FINISHED","title":{"english":"Hunter x Hunter (2011)","native":"HUNTER×HUNTER (2011)","romaji":"HUNTER×HUNTER (2011)","userPreferred":"Hunter x Hunter (2011)"},"trailer":{"id":"d6kBeJjTGnY","site":"youtube","thumbnail":"https://i.ytimg.com/vi/d6kBeJjTGnY/hqdefault.jpg"},"type":"ANIME"}}},{"node":{"mediaRecommendation":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/20-HHxhPj5JD13a.jpg","coverImage":{"color":"#e47850","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx20-dE6UHbFFg1A5.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx20-dE6UHbFFg1A5.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx20-dE6UHbFFg1A5.jpg"},"description":"Naruto Uzumaki, a hyperactive and knuckle-headed ninja, lives in Konohagakure, the Hidden Leaf village. Moments prior to his birth, a huge demon known as the Kyuubi, the Nine-tailed Fox, attacked Konohagakure and wreaked havoc. In order to put an end to the Kyuubi's rampage, the leader of the village, the 4th Hokage, sacrificed his life and sealed the monstrous beast inside the newborn Naruto. \u003cbr\u003e\u003cbr\u003e\nShunned because of the presence of the Kyuubi inside him, Naruto struggles to find his place in the village. He strives to become the Hokage of Konohagakure, and he meets many friends and foes along the way. \u003cbr\u003e\u003cbr\u003e\n(Source: MAL Rewrite)","episodes":220,"format":"TV","id":20,"idMal":20,"isAdult":false,"meanScore":80,"season":"FALL","siteUrl":"https://anilist.co/anime/20","startDate":{"day":3,"month":10,"year":2002},"status":"FINISHED","title":{"english":"Naruto","native":"NARUTO -ナルト-","romaji":"NARUTO","userPreferred":"Naruto"},"trailer":{"id":"-G9BqkgZXRA","site":"youtube","thumbnail":"https://i.ytimg.com/vi/-G9BqkgZXRA/hqdefault.jpg"},"type":"ANIME"}}},{"node":{"mediaRecommendation":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/1735.jpg","coverImage":{"color":"#e4865d","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx1735-kGfVm0YqCPcu.png","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx1735-kGfVm0YqCPcu.png","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx1735-kGfVm0YqCPcu.png"},"description":"Naruto: Shippuuden is the continuation of the original animated TV series Naruto. The story revolves around an older and slightly more matured Uzumaki Naruto and his quest to save his friend Uchiha Sasuke from the grips of the snake-like Shinobi, Orochimaru. After 2 and a half years Naruto finally returns to his village of Konoha, and sets about putting his ambitions to work, though it will not be easy, as he has amassed a few (more dangerous) enemies, in the likes of the shinobi organization; Akatsuki. \u003cbr\u003e\u003cbr\u003e\n(Source: Anime News Network)","episodes":500,"format":"TV","id":1735,"idMal":1735,"isAdult":false,"meanScore":82,"season":"WINTER","siteUrl":"https://anilist.co/anime/1735","startDate":{"day":15,"month":2,"year":2007},"status":"FINISHED","title":{"english":"Naruto: Shippuden","native":"NARUTO -ナルト- 疾風伝","romaji":"NARUTO: Shippuuden","userPreferred":"Naruto: Shippuden"},"type":"ANIME"}}},{"node":{"mediaRecommendation":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/97940-1URQdQ4U1a0b.jpg","coverImage":{"color":"#d6c96b","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx97940-fyh8o7gNbha0.png","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx97940-fyh8o7gNbha0.png","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx97940-fyh8o7gNbha0.png"},"description":"In a world where magic is everything, Asta and Yuno are both found abandoned at a church on the same day. While Yuno is gifted with exceptional magical powers, Asta is the only one in this world without any. At the age of fifteen, both receive grimoires, magic books that amplify their holder’s magic. Asta’s is a rare Grimoire of Anti-Magic that negates and repels his opponent’s spells. Being opposite but good rivals, Yuno and Asta are ready for the hardest of challenges to achieve their common dream: to be the Wizard King. Giving up is never an option!\u003cbr\u003e\n\u003cbr\u003e\n(Source: Crunchyroll)","episodes":170,"format":"TV","id":97940,"idMal":34572,"isAdult":false,"meanScore":79,"season":"FALL","siteUrl":"https://anilist.co/anime/97940","startDate":{"day":3,"month":10,"year":2017},"status":"FINISHED","title":{"english":"Black Clover","native":"ブラッククローバー","romaji":"Black Clover","userPreferred":"Black Clover"},"trailer":{"id":"vUjAxk1qYzQ","site":"youtube","thumbnail":"https://i.ytimg.com/vi/vUjAxk1qYzQ/hqdefault.jpg"},"type":"ANIME"}}},{"node":{"mediaRecommendation":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/223-vyRuUBBYfcUb.jpg","coverImage":{"color":"#e48635","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx223-scE5uJfXqqj8.png","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx223-scE5uJfXqqj8.png","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx223-scE5uJfXqqj8.png"},"description":"Goku Son is a young boy who lives in the woods all alone—that is until a girl named Bulma runs into him in her search for a set of magical objects called the \"Dragon Balls.\" Since the artifacts are said to grant one wish to whoever collects all seven, Bulma hopes to gather them and wish for a perfect boyfriend. Goku happens to be in possession of a dragon ball, but unfortunately for Bulma, he refuses to part ways with it, so she makes him a deal: he can tag along on her journey if he lets her borrow the dragon ball's power. With that, the two set off on the journey of a lifetime.\u003cbr\u003e\n\u003cbr\u003e\nThey don't go on the journey alone. On the way, they meet the old Muten-Roshi and wannabe disciple Kuririn, with whom Goku trains to become a stronger martial artist for the upcoming World Martial Arts Tournament. However, it's not all fun and games; the ability to make any wish come true is a powerful one, and there are others who would do much worse than just wishing for a boyfriend. To stop those who would try to abuse the legendary power, they train to become stronger fighters, using their newfound strength to help the people around them along the way.\u003cbr\u003e\n\u003cbr\u003e\n(Source: MAL Rewrite)","episodes":153,"format":"TV","id":223,"idMal":223,"isAdult":false,"meanScore":78,"season":"WINTER","siteUrl":"https://anilist.co/anime/223","startDate":{"day":26,"month":2,"year":1986},"status":"FINISHED","title":{"english":"Dragon Ball","native":"ドラゴンボール","romaji":"Dragon Ball","userPreferred":"Dragon Ball"},"type":"ANIME"}}},{"node":{"mediaRecommendation":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/813-03ZLvWJgR6Wd.jpg","coverImage":{"color":"#e49343","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx813-ZhnFNOeCU5dQ.png","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx813-ZhnFNOeCU5dQ.png","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx813-ZhnFNOeCU5dQ.png"},"description":"Goku is back with his new son, Gohan, but just when things are getting settled down, the adventures continue. Whether he is facing enemies such as Freeza, Cell, or Boo, Goku is proven to be an elite of his own and discovers his race, Saiyan. He meets many new people, gaining allies as well as enemies, as he still finds time to raise a family and be the happy-go-lucky Saiyan he is.\u003cbr\u003e\u003cbr\u003e\n(Source: Anime News Network)","episodes":291,"format":"TV","id":813,"idMal":813,"isAdult":false,"meanScore":80,"season":"SPRING","siteUrl":"https://anilist.co/anime/813","startDate":{"day":26,"month":4,"year":1989},"status":"FINISHED","title":{"english":"Dragon Ball Z","native":"ドラゴンボールZ","romaji":"Dragon Ball Z","userPreferred":"Dragon Ball Z"},"type":"ANIME"}}},{"node":{"mediaRecommendation":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/269-08ar2HJOUAuL.jpg","coverImage":{"color":"#f1a150","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx269-d2GmRkJbMopq.png","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx269-d2GmRkJbMopq.png","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx269-d2GmRkJbMopq.png"},"description":"Ichigo Kurosaki is a rather normal high school student apart from the fact he has the ability to see ghosts. This ability never impacted his life in a major way until the day he encounters the Shinigami Kuchiki Rukia, who saves him and his family's lives from a Hollow, a corrupt spirit that devours human souls. \n\u003cbr\u003e\u003cbr\u003e\nWounded during the fight against the Hollow, Rukia chooses the only option available to defeat the monster and passes her Shinigami powers to Ichigo. Now forced to act as a substitute until Rukia recovers, Ichigo hunts down the Hollows that plague his town. \n\n\n","episodes":366,"format":"TV","id":269,"idMal":269,"isAdult":false,"meanScore":79,"season":"FALL","siteUrl":"https://anilist.co/anime/269","startDate":{"day":5,"month":10,"year":2004},"status":"FINISHED","title":{"english":"Bleach","native":"BLEACH","romaji":"BLEACH","userPreferred":"Bleach"},"trailer":{"id":"0c4IoCA5fY0","site":"youtube","thumbnail":"https://i.ytimg.com/vi/0c4IoCA5fY0/hqdefault.jpg"},"type":"ANIME"}}},{"node":{"mediaRecommendation":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/6702-VSHyctSAeUBS.jpg","coverImage":{"color":"#e45d50","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/b6702-KI4qgSMyI8Pm.png","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/b6702-KI4qgSMyI8Pm.png","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/b6702-KI4qgSMyI8Pm.png"},"description":"Across the Fiore kingdom, wizards join guilds and make their pay by filling magical needs—but one guild has a reputation as the roughest, rowdiest, most dangerous of all: Fairy Tail!\u003cbr\u003e\nWhen four young Fairy Tail members unite, their bond is forged by a power found in neither muscle nor magic and grows stronger with every mission. Whatever you do, don't mess with these friends or you'll get a taste of Natsu's flaming fist or Gray's ice hammer, suffer a painful blow from one of Lucy's celestial spirits or catch the edge of Erza's mighty blade! Whether they're stopping demons from devastating the world or wrestling in the mess hall, this mystical team manages to inflict as much damage to their rivals as they do to the surrounding area!\u003cbr\u003e\n\u003cbr\u003e\n(Source: Funimation)","episodes":175,"format":"TV","id":6702,"idMal":6702,"isAdult":false,"meanScore":72,"season":"FALL","siteUrl":"https://anilist.co/anime/6702","startDate":{"day":12,"month":10,"year":2009},"status":"FINISHED","title":{"english":"Fairy Tail","native":"FAIRY TAIL","romaji":"FAIRY TAIL","userPreferred":"Fairy Tail"},"trailer":{"id":"mAAKPx-ndAg","site":"youtube","thumbnail":"https://i.ytimg.com/vi/mAAKPx-ndAg/hqdefault.jpg"},"type":"ANIME"}}}]},"relations":{"edges":[{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/466-uS8J4XwJ35Ws.png","countryOfOrigin":"JP","coverImage":{"color":"#e49328","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/nx466-bVP54I7dCB2F.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/nx466-bVP54I7dCB2F.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/nx466-bVP54I7dCB2F.jpg"},"description":"While Luffy and his crew of Zoro and Nami are starving on their small boat, they are attacked by a large monster. Nami is taken away, while Luffy and Zoro wash up on shore. There they meet a young girl, Medaka, and learn of the sad history of the island. The evil Pirate Ganzack has taken away all the men in the village and enslaved them, including Medaka's father. Now Luffy, Zoro, and Medaka must infiltrate Ganzack's base in order to rescue the villagers and Nami. \u003cbr\u003e\u003cbr\u003e\n(Source: Anime News Network)","duration":28,"endDate":{"day":26,"month":7,"year":1998},"episodes":1,"format":"OVA","genres":["Adventure","Comedy","Fantasy"],"id":466,"idMal":466,"isAdult":false,"meanScore":64,"season":"SUMMER","seasonYear":1998,"siteUrl":"https://anilist.co/anime/466","startDate":{"day":26,"month":7,"year":1998},"status":"FINISHED","synonyms":["Defeat Him! The Pirate Ganzack!","ONE PIECE ジャンプスーパーアニメツアー'98","ONE PIECE Jump Super Anime Tour '98"],"title":{"english":"One Piece: Defeat the Pirate Ganzack!","native":"ONE PIECE 倒せ!海賊ギャンザック","romaji":"ONE PIECE: Taose! Kaizoku Ganzack","userPreferred":"One Piece: Defeat the Pirate Ganzack!"},"type":"ANIME"},"relationType":"SIDE_STORY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/n1094-IAIqiFbLBsig.jpg","countryOfOrigin":"JP","coverImage":{"color":"#f1a10d","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx1094-H3YFJ1TR0ZZi.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx1094-H3YFJ1TR0ZZi.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx1094-H3YFJ1TR0ZZi.jpg"},"description":"The Straw Hats encounter a city in the middle of a whirlpool, called the Ocean's Navel, that is being destroyed by giant monsters. These monsters supposedly protect a treasure capable of granting wishes, but in the process of defeating these guardians, the crew ends up releasing another evil.  (aired after Episode 53)\u003cbr\u003e","duration":49,"endDate":{"day":20,"month":12,"year":2000},"episodes":1,"format":"SPECIAL","genres":["Adventure","Comedy","Fantasy"],"id":1094,"idMal":1094,"isAdult":false,"meanScore":67,"season":"FALL","seasonYear":2000,"siteUrl":"https://anilist.co/anime/1094","startDate":{"day":20,"month":12,"year":2000},"status":"FINISHED","synonyms":["One Piece: Avventura nell'ombelico dell'oceano","One Piece Special: Adventure in the Ocean's Navel","วันพีซ ภาคพิเศษ 1 การผจญภัยใต้มหาสมุทร","Vua Hải Tặc: Cuộc phiêu lưu vào rốn đại dương","One Piece Special: Luffy Falls! Adventure in the Navel of the Sea"],"title":{"english":"One Piece: Umi no Heso no Daibouken-hen","native":"ONE PIECE TVスペシャル 海のヘソの大冒険篇","romaji":"ONE PIECE TV Special: Umi no Heso no Daibouken-hen","userPreferred":"One Piece: Umi no Heso no Daibouken-hen"},"type":"ANIME"},"relationType":"SIDE_STORY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/n1237-hHWuRsuVsVpr.jpg","countryOfOrigin":"JP","coverImage":{"color":"#e4ae35","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/1237.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/1237.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/1237.jpg"},"description":"The story opens on Pirate Zap's ship, where two of his crew, Bonnie and Max, are tired and want to escape, but unfortunately they have no money. Three children were being held captive on the ship overhear them. The eldest, Amanda, who's father was a pro treasure hunter, knows the whereabouts of a great treasure, and offers them a deal. If they help them make a clean escape, they could take all the treasure they wanted. They agree, and the five of them barely escape and make it onto a small island where they meet Luffy and his crew. Unfortunately they were pursued and Luffy and Amanda are captured and brought back to their boss, the head of the Bayan Pirates, who is also after the treasure. Now Luffy and the others must battle the Bayan pirates and find the treasure that Amanda's father had left for his children. Amanda, who has always resented adventure and treasure because her father was constantly gone in search for it, finally understands his feelings. \u003cbr\u003e\u003cbr\u003e\n(Source: Anime News Network)","duration":46,"endDate":{"day":6,"month":4,"year":2003},"episodes":1,"format":"SPECIAL","genres":["Adventure","Comedy","Fantasy"],"id":1237,"idMal":1237,"isAdult":false,"meanScore":67,"season":"SPRING","seasonYear":2003,"siteUrl":"https://anilist.co/anime/1237","startDate":{"day":6,"month":4,"year":2003},"status":"FINISHED","synonyms":["One Piece: Un tesoro grande un sogno","วันพีซ ภาคพิเศษ 2 ออกสู่ทะเลกว้างใหญ่ ความฝันอันยิ่งใหญ่ของพ่อ","Vua Hải Tặc: Vươn ra đại dương! Giấc mơ to lớn của bố!"],"title":{"english":"One Piece Special: Open Upon the Great Sea! A Father's Huge, HUGE Dream!","native":"ONE PIECE: 大海原にひらけ! でっかいでっカイ父の夢","romaji":"ONE PIECE: Oounabara ni Hirake! Dekkai Dekkai Chichi no Yume!","userPreferred":"One Piece Special: Open Upon the Great Sea! A Father's Huge, HUGE Dream!"},"type":"ANIME"},"relationType":"SIDE_STORY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/n1238-HdBlNr5vwNau.jpg","countryOfOrigin":"JP","coverImage":{"color":"#5dc9f1","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx1238-Rf2wqBrCwgvO.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx1238-Rf2wqBrCwgvO.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx1238-Rf2wqBrCwgvO.jpg"},"description":"For many years, Ex-Marine Lieutenant Randolph and his troupe have put on a play aboard his ship. Having lost his family to pirates, Randolph wishes to put on plays that will give courage to those who have also lost their loved ones to pirates. Unfortunately, Randolph must retire soon, and he is now giving his last performance. Luffy and his crew come to see the play, and somehow manage to take part in it themselves. But from Randolph's past comes a vengeful subordinate with a diabolical plan who has finally become commander in order to capture Randolph. Luffy and his nakama now must prove to the people that not all pirates are scum, and protect Randolph's final farewell performance from the bitter commander. (aired after Episode 174)\u003cbr\u003e\u003cbr\u003e\n(Source: Anime News Network)","duration":45,"endDate":{"day":14,"month":12,"year":2003},"episodes":1,"format":"SPECIAL","genres":["Action","Adventure","Comedy","Fantasy"],"id":1238,"idMal":1238,"isAdult":false,"meanScore":69,"season":"WINTER","seasonYear":2003,"siteUrl":"https://anilist.co/anime/1238","startDate":{"day":14,"month":12,"year":2003},"status":"FINISHED","synonyms":["One Piece TV Special 3","One Piece: L'ultima esibizione","守れ!最後の大舞台","One Piece: Mamore! Saigo no Daibutai","One Piece Special: Protect! The Last Great Stage","วันพีซ ภาคพิเศษ 3 ป้องกันการแสดงครั้งสุดท้ายอันยิ่งใหญ่ ","Vua Hải Tặc: Bảo vệ! Vở diễn lớn cuối cùng","ONE PIECE TVスペシャル3 守れ! 最後の大舞台"],"title":{"english":"One Piece Special: Protect! The Last Great Performance","native":"ONE PIECE 守れ! 最後の大舞台","romaji":"ONE PIECE: Mamore! Saigo no Oobutai","userPreferred":"One Piece Special: Protect! The Last Great Performance"},"type":"ANIME"},"relationType":"SIDE_STORY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/n2020-k3lHutyP9i06.jpg","countryOfOrigin":"JP","coverImage":{"color":"#f1bb35","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/2020.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/2020.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/2020.jpg"},"description":"Unlike the other specials, this story takes place in an alternate reality version of 19th century Japan, in \"The Grand Jipangu\", an alternate version of The Grand Line as opposed to simply being hour-long filler episodes.The story is divided into two halves: in the first, Buggy the Clown makes trouble in the town where Detective Luffy is stationed, and in the second a mysterious girl named Vivi appears. These stories feature cameos from several minor characters in the normal series. Surprisingly the \"Oyabun\" (Boss) specials did not stop there as five more specials were made following the first one, mostly as Christmas and New Years specials as well as fillers once in awhile.\u003cbr\u003e","duration":44,"endDate":{"day":18,"month":12,"year":2005},"episodes":1,"format":"SPECIAL","genres":["Adventure","Comedy","Fantasy"],"id":2020,"idMal":2020,"isAdult":false,"meanScore":68,"season":"FALL","seasonYear":2005,"siteUrl":"https://anilist.co/anime/2020","startDate":{"day":18,"month":12,"year":2005},"status":"FINISHED","synonyms":["One Piece: Le avventure del detective Cappello di Paglia"],"title":{"english":"One Piece Special: The Detective Memoirs of Chief Straw Hat Luffy","native":"ONE PIECE 年末特別企画！麦わらのルフィ親分捕物帖","romaji":"ONE PIECE: Nenmatsu Tokubetsu Kikaku! Mugiwara no Luffy Oyabun Torimonochou","userPreferred":"One Piece Special: The Detective Memoirs of Chief Straw Hat Luffy"},"type":"ANIME"},"relationType":"SIDE_STORY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/2386-jtduFM8raO2z.jpg","countryOfOrigin":"JP","coverImage":{"color":"#d6931a","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/2386-NQQkq1taHJ08.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/2386-NQQkq1taHJ08.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/2386-NQQkq1taHJ08.jpg"},"description":"Luffy and his crew take on the Villain All-Stars in a game of soccer in order to become the Dream Soccer King. The game comes down to a pk tie-breaker shoot-out with Coby as goalie and Helmeppo refereeing.\u003cbr\u003e\u003cbr\u003e\n(Source: Anime News Network) ","duration":5,"endDate":{"day":2,"month":3,"year":2002},"episodes":1,"format":"SPECIAL","genres":["Comedy","Fantasy","Sports"],"id":2386,"idMal":2386,"isAdult":false,"meanScore":66,"season":"SPRING","seasonYear":2002,"siteUrl":"https://anilist.co/anime/2386","startDate":{"day":2,"month":3,"year":2002},"status":"FINISHED","synonyms":["One Piece: Dream Soccer King!"],"title":{"native":"ONE PIECE 夢のサッカー王!","romaji":"ONE PIECE: Yume no Soccer Ou!","userPreferred":"ONE PIECE: Yume no Soccer Ou!"},"type":"ANIME"},"relationType":"SIDE_STORY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/2490-wlPYONPyTibY.jpg","countryOfOrigin":"JP","coverImage":{"color":"#ffbb43","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/2490-AL4WmnCJ5zvE.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/2490-AL4WmnCJ5zvE.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/2490-AL4WmnCJ5zvE.jpg"},"description":"Luffy and crew takes on Arlong's crew in baseball. Announced by Bon Clay and Buggy.\u003cbr\u003e\u003cbr\u003e\n(Source: Anime News Network)","duration":5,"endDate":{"day":6,"month":3,"year":2004},"episodes":1,"format":"SPECIAL","genres":["Comedy","Fantasy","Sports"],"id":2490,"idMal":2490,"isAdult":false,"meanScore":64,"season":"SPRING","seasonYear":2004,"siteUrl":"https://anilist.co/anime/2490","startDate":{"day":6,"month":3,"year":2004},"status":"FINISHED","synonyms":["One Piece: Take Aim! The Pirate Baseball King"],"title":{"native":"ONE PIECE めざせ! 海賊野球王","romaji":"ONE PIECE: Mezase! Kaizoku Yakyuu Ou","userPreferred":"ONE PIECE: Mezase! Kaizoku Yakyuu Ou"},"type":"ANIME"},"relationType":"SIDE_STORY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/n12001-IljdXqN8CTU7.jpg","countryOfOrigin":"JP","coverImage":{"color":"#f1e435","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/nx12001-XX0NNNfaKZ3e.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/nx12001-XX0NNNfaKZ3e.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/nx12001-XX0NNNfaKZ3e.jpg"},"description":"Toei Animation released a new 3D anime short at events starting December 1, 2011. The short run about 12 minutes long and played at stereoscopic 3D theaters at Aichi Prefecture's Lagunasia theme park, Nagasaki Prefecture's Huis Ten Bosch theme park, Kanagawa Prefecture's Yokohama Landmark Tower, and Hiroshima Prefecture's NTT CRED Hall.\u003cbr\u003e\u003cbr\u003e\n(Source: Anime News Network)","duration":12,"endDate":{"day":1,"month":12,"year":2011},"episodes":1,"format":"MOVIE","genres":["Action","Adventure","Comedy"],"id":12001,"idMal":12001,"isAdult":false,"meanScore":61,"season":"FALL","seasonYear":2011,"siteUrl":"https://anilist.co/anime/12001","startDate":{"day":1,"month":12,"year":2011},"status":"FINISHED","title":{"native":"ONE PIECE 3D 激走! トラップコースター","romaji":"ONE PIECE 3D: Gekisou! Trap Coaster","userPreferred":"ONE PIECE 3D: Gekisou! Trap Coaster"},"type":"ANIME"},"relationType":"SIDE_STORY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/16239-pov53U1T1dRm.jpg","countryOfOrigin":"JP","coverImage":{"color":"#f1c900","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/b16239-XzoVjd7JK8xJ.png","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/b16239-XzoVjd7JK8xJ.png","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/b16239-XzoVjd7JK8xJ.png"},"description":"The story of the Hand Island no Bouken special is set a little before the events of One Piece Film Z and depicts a major \"Hand Island\" incident during the New World storyline. The story is set at \"Cannon Town\" where a parent and a child work as craftspeople. The incident revolves around them and a commodore of a marine base. The special will also have a flashback scene to the story in the first chapter of the manga, but with new animation. \u003cbr\u003e\u003cbr\u003e\n(Source: Anime News Network) ","duration":102,"endDate":{"day":15,"month":12,"year":2012},"episodes":1,"format":"SPECIAL","genres":["Action","Adventure","Comedy","Fantasy"],"id":16239,"idMal":16239,"isAdult":false,"meanScore":72,"season":"FALL","seasonYear":2012,"siteUrl":"https://anilist.co/anime/16239","startDate":{"day":15,"month":12,"year":2012},"status":"FINISHED","title":{"english":"One Piece: Episode of Luffy - Hand Island Adventure","native":"ONE PIECE エピソードオブルフィ 〜ハンドアイランドの冒険〜","romaji":"ONE PIECE: Episode of Luffy - Hand Island no Bouken","userPreferred":"One Piece: Episode of Luffy - Hand Island Adventure"},"type":"ANIME"},"relationType":"SIDE_STORY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/n16468-yOxhsBHFICtu.jpg","countryOfOrigin":"JP","coverImage":{"color":"#feae28","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/b16468-pMKFwfY8lYZX.png","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/b16468-pMKFwfY8lYZX.png","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/b16468-pMKFwfY8lYZX.png"},"description":"An exclusive anime prologue to One Piece Film Z with an original story penned by manga creator Eiichiro Oda. \u003cbr\u003e\u003cbr\u003e\n(Source: Anime News Network) ","duration":5,"endDate":{"day":30,"month":12,"year":2012},"episodes":2,"format":"SPECIAL","genres":["Action","Adventure","Comedy","Fantasy"],"id":16468,"idMal":16468,"isAdult":false,"meanScore":69,"season":"FALL","seasonYear":2012,"siteUrl":"https://anilist.co/anime/16468","startDate":{"day":23,"month":12,"year":2012},"status":"FINISHED","synonyms":["One Piece: Glorious Island","One Piece Special: Glorious Island","ワンピース フィルム ゼット グロリアス アイランド"],"title":{"native":"ONE PIECE FILM Z『GLORIOUS ISLAND』","romaji":"ONE PIECE FILM: Z - GLORIOUS ISLAND","userPreferred":"ONE PIECE FILM: Z - GLORIOUS ISLAND"},"type":"ANIME"},"relationType":"SIDE_STORY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/15323-zrax5OGlGepE.png","countryOfOrigin":"JP","coverImage":{"color":"#fed628","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/15323.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/15323.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/15323.jpg"},"description":"A retelling of the Arlong Park arc, with new animation.","duration":105,"endDate":{"day":25,"month":8,"year":2012},"episodes":1,"format":"SPECIAL","genres":["Action","Adventure","Comedy","Drama","Fantasy"],"id":15323,"idMal":15323,"isAdult":false,"meanScore":78,"season":"SUMMER","seasonYear":2012,"siteUrl":"https://anilist.co/anime/15323","startDate":{"day":25,"month":8,"year":2012},"status":"FINISHED","synonyms":["One Piece Special"],"title":{"native":"ONE PIECE エピソードオブナミ 〜航海士の涙と仲間の絆〜","romaji":"ONE PIECE: Episode of Nami - Koukaishi no Namida to Nakama no Kizuna","userPreferred":"ONE PIECE: Episode of Nami - Koukaishi no Namida to Nakama no Kizuna"},"type":"ANIME"},"relationType":"SUMMARY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/19123-QyRShJCfnIWD.jpg","countryOfOrigin":"JP","coverImage":{"color":"#e4c95d","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/nx19123-leET1CrSJknT.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/nx19123-leET1CrSJknT.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/nx19123-leET1CrSJknT.jpg"},"description":"The story arcs aboard the Straw Hat Crew's first ship Going Merry (Merry Go in some adaptations) are recreated with brand-new animation, from Luffy and Usopp's fight and Robin's disappearance to the crew's final farewell to the ship. Going Merry is treated as another member of the Straw Hats as Luffy, Zoro, Nami, and the rest of the crew set sail for the legendary treasure, the One Piece.\u003cbr\u003e\u003cbr\u003e\n(Source: Anime News Network)","duration":106,"endDate":{"day":24,"month":8,"year":2013},"episodes":1,"format":"SPECIAL","genres":["Action","Adventure","Comedy","Drama","Fantasy"],"id":19123,"idMal":19123,"isAdult":false,"meanScore":78,"season":"SUMMER","seasonYear":2013,"siteUrl":"https://anilist.co/anime/19123","startDate":{"day":24,"month":8,"year":2013},"status":"FINISHED","synonyms":["One Piece Special"],"title":{"english":"One Piece: Episode of Merry - The Tale of One More Friend","native":"ONE PIECE エピソードオブメリー 〜もうひとりの仲間の物語〜","romaji":"ONE PIECE: Episode of Merry - Mou Hitori no Nakama no Monogatari","userPreferred":"One Piece: Episode of Merry - The Tale of One More Friend"},"type":"ANIME"},"relationType":"SUMMARY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/20835-aR8CuXvtzqND.jpg","countryOfOrigin":"JP","coverImage":{"color":"#e47850","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx20835-QVV6LpJlqe1A.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx20835-QVV6LpJlqe1A.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx20835-QVV6LpJlqe1A.jpg"},"description":"This new TV special tells the two years of Luffy's training with Silvers Rayleigh in Rusukaina Island after the Battle of Marineford, which has never been told in the manga or TV anime. It also features a new villain named Burndy World who is known as \"The Destroyer of the World\" and has the power of the MoaMoa Fruit (its ability is still unknown). Luffy has to protect Boa Hancock from the new enemy who escaped from the level 6 of Impel Down. He is newly designed by the original creator of the manga, Eiichiro Oda.\u003cbr\u003e\r\n\u003cbr\u003e\r\n(Source: Crunchyroll)","duration":107,"endDate":{"day":30,"month":8,"year":2014},"episodes":1,"format":"SPECIAL","genres":["Action","Comedy","Fantasy"],"id":20835,"idMal":25161,"isAdult":false,"meanScore":76,"season":"SUMMER","seasonYear":2014,"siteUrl":"https://anilist.co/anime/20835","startDate":{"day":30,"month":8,"year":2014},"status":"FINISHED","synonyms":["One Piece Special 15th Anniversary"],"title":{"english":"One Piece 3D2Y: Overcome Ace’s Death! Luffy’s Vow to his Friends","native":"ONE PIECE “3D2Y” エースの死を越えて! ルフィ仲間との誓い","romaji":"ONE PIECE \"3D2Y\": Ace no shi wo Koete! Luffy Nakama to no Chikai","userPreferred":"One Piece 3D2Y: Overcome Ace’s Death! Luffy’s Vow to his Friends"},"type":"ANIME"},"relationType":"SIDE_STORY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/21230-5yju21iK6aMW.jpg","countryOfOrigin":"JP","coverImage":{"color":"#f1a150","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx21230-rfoUZud1Jn0L.png","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx21230-rfoUZud1Jn0L.png","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx21230-rfoUZud1Jn0L.png"},"description":"The anime will explore the childhood bond between Luffy, Ace and Sabo.","duration":110,"endDate":{"day":22,"month":8,"year":2015},"episodes":1,"format":"SPECIAL","genres":["Action","Adventure","Comedy","Drama"],"id":21230,"idMal":31289,"isAdult":false,"meanScore":74,"season":"SUMMER","seasonYear":2015,"siteUrl":"https://anilist.co/anime/21230","startDate":{"day":22,"month":8,"year":2015},"status":"FINISHED","synonyms":["One Piece: Episode of Sabo - The Three Brothers' Bond: The Miraculous Reunion and the Inherited Will"],"title":{"english":"One Piece - Episode of Sabo: Bond of Three Brothers - A Miraculous Reunion and an Inherited Will","native":"ONE PIECE エピソードオブサボ ~3兄弟の絆 奇跡の再会と受け継がれる意志~","romaji":"ONE PIECE: Episode of Sabo - 3-Kyoudai no Kizuna Kiseki no Saikai to Uketsugareru Ishi","userPreferred":"One Piece - Episode of Sabo: Bond of Three Brothers - A Miraculous Reunion and an Inherited Will"},"type":"ANIME"},"relationType":"SUMMARY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/21485-lPFbmxGrFsBX.jpg","countryOfOrigin":"JP","coverImage":{"color":"#e4bb43","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/21485-KR1sv4rYSe6V.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/21485-KR1sv4rYSe6V.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/21485-KR1sv4rYSe6V.jpg"},"description":"The Davy Back Fight Arc competitors journey to New World with new crew members Dojaku, Kansho and tactical genius Komei for a meeting that will take place on a foggy island that makes devil fruit users unable to use to their abilities.","duration":116,"endDate":{"day":19,"month":12,"year":2015},"episodes":1,"format":"SPECIAL","genres":["Action","Adventure","Comedy","Drama","Fantasy"],"id":21485,"idMal":32051,"isAdult":false,"meanScore":69,"season":"FALL","seasonYear":2015,"siteUrl":"https://anilist.co/anime/21485","startDate":{"day":19,"month":12,"year":2015},"status":"FINISHED","synonyms":["One Piece - Aventura en Nebulandia"],"title":{"english":"One Piece: Adventure of Nebulandia","native":"ONE PIECE 〜アドベンチャー オブ ネブランディア〜","romaji":"ONE PIECE: Adventure of Nebulandia","userPreferred":"One Piece: Adventure of Nebulandia"},"type":"ANIME"},"relationType":"SIDE_STORY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/21831-Xl4r2uBaaKU4.png","countryOfOrigin":"JP","coverImage":{"color":"#f1a10d","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx21831-qj5IKYiPOupF.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx21831-qj5IKYiPOupF.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx21831-qj5IKYiPOupF.jpg"},"description":"The Straw Hat Pirates meet Olga, a girl who has escaped the island Alchemi. Alchemi was known for its metal production, and for the creation of the extremely valuable Pure Gold, but the island disappeared two hundred years ago. Olga is now being pursued by Marines, interested in Pure Gold. Gildo Tesoro, who controls the Navy HQ and black market, hears of Olga and hires treasure hunter Mad Treasure to track her down. The Straw Hats join forces with Olga in search of the Pure Gold, while she plots to takes advantage of them and use the treasure to become rich herself.","duration":104,"endDate":{"day":16,"month":7,"year":2016},"episodes":1,"format":"SPECIAL","genres":["Action","Adventure","Comedy","Drama","Fantasy"],"id":21831,"idMal":33338,"isAdult":false,"meanScore":73,"season":"SUMMER","seasonYear":2016,"siteUrl":"https://anilist.co/anime/21831","startDate":{"day":16,"month":7,"year":2016},"status":"FINISHED","title":{"english":"One Piece: Heart of Gold","native":"ONE PIECE 〜ハートオブゴールド〜","romaji":"ONE PIECE: Heart of Gold","userPreferred":"One Piece: Heart of Gold"},"type":"ANIME"},"relationType":"SIDE_STORY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/99302-v3NwmsSnjj94.jpg","countryOfOrigin":"JP","coverImage":{"color":"#bbe45d","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx99302-b40WIhc5dylo.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx99302-b40WIhc5dylo.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx99302-b40WIhc5dylo.jpg"},"description":"The special will be a completely new work, featuring reanimated scenes from the beginning of the series through when the crew enters the Grand Line.\u003cbr\u003e\n\u003cbr\u003e\nThe special is commemorating the manga's 20th anniversary, and will also feature anime versions of the original manga's chapter cover stories as part of the special's ending credits. The staff haven't yet clarified which cover story or stories will be animated. Additionally, the anime will feature a special 20th anniversary commemoration version of the original opening theme song \"We Are!\".\u003cbr\u003e\n\u003cbr\u003e\n(Source: Anime News Network)","duration":106,"endDate":{"day":26,"month":8,"year":2017},"episodes":1,"format":"SPECIAL","genres":["Action","Adventure","Drama"],"id":99302,"idMal":36215,"isAdult":false,"meanScore":76,"season":"SUMMER","seasonYear":2017,"siteUrl":"https://anilist.co/anime/99302","startDate":{"day":26,"month":8,"year":2017},"status":"FINISHED","title":{"english":"One Piece: Episode of East Blue","native":"ONE PIECE エピソードオブ東の海〜ルフィと4人の仲間の大冒険!!〜","romaji":"ONE PIECE: Episode of East Blue - Luffy to 4-nin no Nakama no Daibouken","userPreferred":"One Piece: Episode of East Blue"},"trailer":{"id":"XcWmgU7X-Is","site":"youtube","thumbnail":"https://i.ytimg.com/vi/XcWmgU7X-Is/hqdefault.jpg"},"type":"ANIME"},"relationType":"SUMMARY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/459-JqlCjcwxxFrr.jpg","countryOfOrigin":"JP","coverImage":{"color":"#e40d0d","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx459-Ivw65mUXackh.png","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx459-Ivw65mUXackh.png","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx459-Ivw65mUXackh.png"},"description":"There once was a pirate known as the Great Gold Pirate Woonan, who obtained almost 1/3 of the world's gold. Over the course of a few years, the pirate's existence faded, and a legend grew that he disappeared with his gold to a remote island, an island pirates continue to search for. Aboard the Going Merry, Luffy and his crew, starved and reckless, are robbed of their treasure. In an attempt to get it back, they wreck the getaway ship, guided by a young boy named Tabio, who's a captured part of El Drago's pirate crew. El Drago's love for gold has driven him to look for Woonan's island, and thanks to Woonan's treasure map, he finds it. During this time, Luffy's crew have been split up, and despite their own circumstances, they must find a way to stop El Drago from obtaining Woonan's gold. \u003cbr\u003e\u003cbr\u003e\n(Source: Anime News Network)","duration":50,"endDate":{"day":4,"month":3,"year":2000},"episodes":1,"format":"MOVIE","genres":["Action","Adventure","Comedy","Fantasy"],"id":459,"idMal":459,"isAdult":false,"meanScore":68,"season":"WINTER","seasonYear":2000,"siteUrl":"https://anilist.co/anime/459","startDate":{"day":4,"month":3,"year":2000},"status":"FINISHED","synonyms":["One Piece: The Movie","One Piece (2000)","One Piece: La Película","วันพีซ เดอะมูฟวี่ 1 เกาะสมบัติแห่งวูนัน","Vua Hải Tặc: Đảo Châu Báu","One Piece: Golden Island Adventure","One Piece - Per tutto l'oro del mondo"],"title":{"english":"ONE PIECE: The Movie","native":"ONE PIECE (Movie)","romaji":"ONE PIECE (Movie)","userPreferred":"ONE PIECE: The Movie"},"type":"ANIME"},"relationType":"SIDE_STORY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/460-mWAlHAJ5MuBg.jpg","countryOfOrigin":"JP","coverImage":{"color":"#e4c943","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx460-p9HObfGUhWn0.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx460-p9HObfGUhWn0.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx460-p9HObfGUhWn0.jpg"},"description":"Informed by the Thief Brothers his ship has been stolen by the Trump Kyoudai (Trump Siblings) who have set up base on Clockwork Island. Monkey D. Luffy, Captain of the Going Merry and aspiring Pirate King works with his crew - Ussop, Zoro, Sanji and Nami to battle their way up Clockwork Island to reclaim their ship.\u003cbr\u003e\u003cbr\u003e\n(Source: Anime News Network)","duration":55,"endDate":{"day":3,"month":3,"year":2001},"episodes":1,"format":"MOVIE","genres":["Action","Adventure","Comedy","Fantasy"],"id":460,"idMal":460,"isAdult":false,"meanScore":67,"season":"SPRING","seasonYear":2001,"siteUrl":"https://anilist.co/anime/460","startDate":{"day":3,"month":3,"year":2001},"status":"FINISHED","synonyms":["One Piece Movie 02","วันพีซ เดอะมูฟวี่ 2 การผจญภัยบนเกาะแห่งฟันเฟือง","Vua Hải Tặc: Cuộc phiêu lưu đến đảo máy đồng hồ ","One Piece - Avventura all'Isola Spirale"],"title":{"english":"One Piece: Clockwork Island Adventure","native":"ONE PIECE ねじまき島の冒険","romaji":"ONE PIECE: Nejimaki-jima no Bouken","userPreferred":"One Piece: Clockwork Island Adventure"},"type":"ANIME"},"relationType":"SIDE_STORY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/461-0pvcIaXC0p70.jpg","countryOfOrigin":"JP","coverImage":{"color":"#e49343","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx461-DC9fMDl3AaK1.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx461-DC9fMDl3AaK1.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx461-DC9fMDl3AaK1.jpg"},"description":"The crew comes upon Crown Island where the animals can talk and they makes Chopper their new king. But there are human hunters there also looking for the legendary horns that will give the person who consumes it immense power. Luffy and friends must stop them from destroying this animal kingdom.\u003cbr\u003e\u003cbr\u003e\n(Source: Anime News Network)","duration":55,"endDate":{"day":2,"month":3,"year":2002},"episodes":1,"format":"MOVIE","genres":["Action","Adventure","Comedy","Fantasy"],"id":461,"idMal":461,"isAdult":false,"meanScore":64,"season":"SPRING","seasonYear":2002,"siteUrl":"https://anilist.co/anime/461","startDate":{"day":2,"month":3,"year":2002},"status":"FINISHED","synonyms":["One Piece Movie 03","วันพีซ เดอะมูฟวี่ 3 เกาะแห่งสรรพสัตว์และราชันย์ช็อปเปอร์ ","Vua Hải Tặc: Vương quốc Chopper trên đảo của những sinh vật lạ","One Piece: Chopper Kingdom of Strange Animal Island","One Piece - Il tesoro del re"],"title":{"english":"One Piece: Chopper’s Kingdom on the Island of Strange Animals","native":"ONE PIECE 珍獣島のチョッパー王国","romaji":"ONE PIECE: Chinjuu-jima no Chopper Oukoku","userPreferred":"One Piece: Chopper’s Kingdom on the Island of Strange Animals"},"type":"ANIME"},"relationType":"SIDE_STORY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/462-Z074owEvilUu.jpg","countryOfOrigin":"JP","coverImage":{"color":"#e49343","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx462-Ig8zfdsFWcql.png","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx462-Ig8zfdsFWcql.png","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx462-Ig8zfdsFWcql.png"},"description":"Luffy and crew arrive at the harbour of Anabaru. The local casino is holding a competition in which the winner will obtain a huge monetary reward if he reaches the finishing line first. Nami is elated and decides to participate in the competition. However, there is a conspiracy going behind the competition and the mastermind is an ex-military commander, Gasparde. His plan is to lure all the pirates to the military base and send them to their deaths. Luffy and gang have to overcome the numerous tests and tribulations along the way to complete this dead-end adventure. \u003cbr\u003e\u003cbr\u003e\n(Source: Anime News Network)","duration":95,"endDate":{"day":1,"month":3,"year":2003},"episodes":1,"format":"MOVIE","genres":["Action","Adventure","Comedy","Fantasy"],"id":462,"idMal":462,"isAdult":false,"meanScore":72,"season":"SPRING","seasonYear":2003,"siteUrl":"https://anilist.co/anime/462","startDate":{"day":1,"month":3,"year":2003},"status":"FINISHED","synonyms":["One Piece Movie 04","One Piece: La Aventura sin Salida","The Adventure of Deadend","One Piece: Dead End","วันพีซ เดอะมูฟวี่ 4 การผจญภัยที่เดดเอนด์","Vua Hải Tặc: Cuộc đua tử thần","One Piece - Trappola mortale"],"title":{"english":"One Piece The Movie: The Dead End Adventure","native":"ONE PIECE THE MOVIE デッドエンドの冒険","romaji":"ONE PIECE THE MOVIE: Dead End no Bouken","userPreferred":"One Piece The Movie: The Dead End Adventure"},"type":"ANIME"},"relationType":"SIDE_STORY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/463-zgU5XjUCR7Kv.jpg","countryOfOrigin":"JP","coverImage":{"color":"#e45078","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/nx463-QDnETPoHp9oD.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/nx463-QDnETPoHp9oD.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/nx463-QDnETPoHp9oD.jpg"},"description":"Luffy and crew go to an island searching for a legendary sword, said to be the most expensive in the world. Soon attacking marines and beautiful maidens split the crew. Zoro betrays the crew to help an old friend, Luffy and Usopp wander through a cave, and the rest help a village fight marines. When Zoro defeats Sanji he takes the sacred pearls that are the only defense against the evil sword that will plunge the world into darkness. \u003cbr\u003e\u003cbr\u003e\n(Source: Anime News Network)","duration":95,"endDate":{"day":6,"month":3,"year":2004},"episodes":1,"format":"MOVIE","genres":["Action","Adventure","Comedy","Fantasy"],"id":463,"idMal":463,"isAdult":false,"meanScore":67,"season":"SPRING","seasonYear":2004,"siteUrl":"https://anilist.co/anime/463","startDate":{"day":6,"month":3,"year":2004},"status":"FINISHED","synonyms":["One Piece Movie 05","One Piece: La Maldición de la Espada Sagrada","One Piece: The Cursed Holy Sword","One Piece : La malédiction de l'épée sacrée","วันพีซ เดอะมูฟวี่ 5 วันดวลดาบ ต้องสาปมรณะ ","Vua Hải Tặc: Thánh kiếm bị nguyền rủa","One Piece - Der Fluch des heiligen Schwerts","One Piece - La spada delle sette stelle"],"title":{"english":"One Piece: The Curse of the Sacred Sword","native":"ONE PIECE 呪われた聖剣","romaji":"ONE PIECE: Norowareta Seiken","userPreferred":"One Piece: The Curse of the Sacred Sword"},"type":"ANIME"},"relationType":"SIDE_STORY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/464-wmQoE1Ywxghs.jpg","countryOfOrigin":"JP","coverImage":{"color":"#e4a15d","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx464-g4wcZPjbhY5j.png","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx464-g4wcZPjbhY5j.png","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx464-g4wcZPjbhY5j.png"},"description":"The Straw Hat crew obtain an advertisement for a recreational island on the Grand Line run by the Baron Omatsuri. Luffy decides to take this opportunity to kick back and relax. Unfortunately, when they arrive at the island, they are asked to compete in contests through unity for access to relaxation. However, there seems to be a mysterious air on the island, as the Straw Hat Pirates begin to fight amongst themselves, while Robin, Chopper, and Luffy individually search for the secret behind Baron Omatsuri's island.\u003cbr\u003e\u003cbr\u003e\n(Source: Anime News Network)","duration":91,"endDate":{"day":5,"month":3,"year":2005},"episodes":1,"format":"MOVIE","genres":["Adventure","Comedy","Fantasy"],"id":464,"idMal":464,"isAdult":false,"meanScore":78,"season":"SPRING","seasonYear":2005,"siteUrl":"https://anilist.co/anime/464","startDate":{"day":5,"month":3,"year":2005},"status":"FINISHED","synonyms":["One Piece Movie 6","One Piece: El barón Omatsuri y la isla de los secretos","One Piece - L'isola segreta del barone Omatsuri"],"title":{"english":"One Piece: Baron Omatsuri and the Secret Island","native":"ONE PIECE THE MOVIE オマツリ男爵と秘密の島","romaji":"ONE PIECE THE MOVIE: Omatsuri Danshaku to Himitsu no Shima","userPreferred":"One Piece: Baron Omatsuri and the Secret Island"},"type":"ANIME"},"relationType":"SIDE_STORY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/465-dYMZ6SHNeOkL.jpg","countryOfOrigin":"JP","coverImage":{"color":"#43aeff","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx465-qSRr0MKYhS0I.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx465-qSRr0MKYhS0I.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx465-qSRr0MKYhS0I.jpg"},"description":"The crew salvages a treasure chest from a sinking wreck, but inside turns out to be an old lady hiding. To get the Straw Hat Pirates to take her home, she promises them the treasure of a golden crown on her island, Mecha Island. When they arrive, their ship is first attacked by the lord of the island. But later he decides to use the pirates to help him solve the riddle of the Golden Crown.\u003cbr\u003e\u003cbr\u003e\n(Source: Anime News Network)","duration":94,"endDate":{"day":4,"month":3,"year":2006},"episodes":1,"format":"MOVIE","genres":["Adventure","Comedy","Fantasy"],"id":465,"idMal":465,"isAdult":false,"meanScore":68,"season":"SPRING","seasonYear":2006,"siteUrl":"https://anilist.co/anime/465","startDate":{"day":4,"month":3,"year":2006},"status":"FINISHED","synonyms":["One Piece: Karakuri Shiro no Mecha Kyohei","One Piece Movie 07","One Piece: El gran soldado mecánico del castillo Karakuri","The Giant Mechanical Soldier of Karakuri Castle","One Piece: Schloss Karakuris Metall-Soldaten","One Piece - I misteri dell'isola meccanica"],"title":{"english":"One Piece: Mega Mecha Soldier of Karakuri Castle","native":"ONE PIECE THE MOVIE カラクリ城のメカ巨兵","romaji":"ONE PIECE THE MOVIE: Karakuri-jou no Mecha Kyohei","userPreferred":"One Piece: Mega Mecha Soldier of Karakuri Castle"},"type":"ANIME"},"relationType":"SIDE_STORY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/2107-Je0JIEoxx1VF.jpg","countryOfOrigin":"JP","coverImage":{"color":"#e4a143","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx2107-H8bRuRRbhCIJ.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx2107-H8bRuRRbhCIJ.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx2107-H8bRuRRbhCIJ.jpg"},"description":"A retelling of the Alabasta arc. \u003cbr\u003e\u003cbr\u003e\nRevolution is brewing in the desert country of Alabasta, but the Straw Hats and Princess Vivi know the truth: it's all a plot cooked up by Crocodile. \u003cbr\u003e\u003cbr\u003e\n(Source: Netflix)","duration":90,"endDate":{"day":3,"month":3,"year":2007},"episodes":1,"format":"MOVIE","genres":["Action","Adventure","Fantasy"],"id":2107,"idMal":2107,"isAdult":false,"meanScore":70,"season":"SPRING","seasonYear":2007,"siteUrl":"https://anilist.co/anime/2107","startDate":{"day":3,"month":3,"year":2007},"status":"FINISHED","synonyms":["One Piece Movie 8: Episode of Alabasta - The Desert Princess and the Pirates","One Piece Película 8: La saga del Arabasta - Los piratas y la princesa del desierto","One Piece Movie 08","One Piece - Un'amicizia oltre i confini del mare"],"title":{"english":"One Piece: The Desert Princess and the Pirates, Adventures in Alabasta","native":"ONE PIECE エピソードオブアラバスタ 砂漠の王女と海賊たち","romaji":"ONE PIECE: Episode of Alabasta - Sabaku no Oujo to Kaizoku-tachi","userPreferred":"One Piece: The Desert Princess and the Pirates, Adventures in Alabasta"},"type":"ANIME"},"relationType":"SUMMARY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/3848-LXsSQtSFu4e9.jpg","countryOfOrigin":"JP","coverImage":{"color":"#e4e450","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx3848-SCnYGTn34Llt.jpg","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx3848-SCnYGTn34Llt.jpg","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx3848-SCnYGTn34Llt.jpg"},"description":"The movie is a retelling of the Drum Island arc with new music and animation. Vivi has been removed from the plot while both Nico Robin and Franky, who joined the crew after the Drum Island arc, have been added. The movie also has the Straw Hat's new ship, the Thousand Sunny. It has been stated that Oda will be creating a new character for this movie, Wapol's older brother, Mushul, who also appears to be a Devil Fruit user. \u003cbr\u003e","duration":113,"endDate":{"day":1,"month":3,"year":2008},"episodes":1,"format":"MOVIE","genres":["Action","Adventure","Comedy","Fantasy"],"id":3848,"idMal":3848,"isAdult":false,"meanScore":71,"season":"SPRING","seasonYear":2008,"siteUrl":"https://anilist.co/anime/3848","startDate":{"day":1,"month":3,"year":2008},"status":"FINISHED","synonyms":["Miracle Sakura","One Piece: Episodio de Chopper + El milagro del cerezo en invierno","One Piece: Episode of Chopper Plus - Bloom in the Winter, Miracle Sakura","One Piece Movie 09","One Piece - Il miracolo dei ciliegi in fiore"],"title":{"english":"One Piece: Episode Of Chopper +: The Miracle Winter Cherry Blossom","native":"ONE PIECE THE MOVIE エピソードオブチョッパー+ 冬に咲く、奇跡の桜","romaji":"ONE PIECE THE MOVIE: Episode of Chopper Plus - Fuyu ni Saku, Kiseki no Sakura","userPreferred":"One Piece: Episode Of Chopper +: The Miracle Winter Cherry Blossom"},"type":"ANIME"},"relationType":"SUMMARY"},{"node":{"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/4155-2PkLjTHddz2s.jpg","countryOfOrigin":"JP","coverImage":{"color":"#e4ae50","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx4155-P5TDf6t6qFwX.png","large":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/bx4155-P5TDf6t6qFwX.png","medium":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/small/bx4155-P5TDf6t6qFwX.png"},"description":"The story begins somewhere between the Thriller Bark arc and the Sabaody Archipelago arc. The main villain's name is \"Golden Lion\" Shiki. 20 years ago he lost a battle against Monkey D. Garp and Sengoku and was imprisoned in Impel Down, but managed to escape. After that he starts to collect his crew and steals Nami to make her his navigator. Luffy tries to get to Shiki's hideout to free his friend. ","duration":113,"endDate":{"day":12,"month":12,"year":2009},"episodes":1,"format":"MOVIE","genres":["Action","Adventure","Comedy","Drama","Fantasy"],"id":4155,"idMal":4155,"isAdult":false,"meanScore":78,"season":"FALL","seasonYear":2009,"siteUrl":"https://anilist.co/anime/4155","startDate":{"day":12,"month":12,"year":2009},"status":"FINISHED","synonyms":["One Piece Film 10","ワンピース ストロング ワールド","One Piece: Strong World","One Piece - Avventura sulle isole volanti"