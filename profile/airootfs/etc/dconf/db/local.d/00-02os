[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/02os/desktop.jpg'
picture-uri-dark='file:///usr/share/backgrounds/02os/desktop.jpg'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/02os/desktop.jpg'

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='adw-gtk3-dark'
icon-theme='02-OS'
cursor-theme='capitaine-cursors'
font-name='Inter 11'
enable-animations=true
clock-show-weekday=true

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'
num-workspaces=4

[org/gnome/desktop/wm/keybindings]
close=['<Super>q', '<Alt>F4']
minimize=['<Super>comma']
toggle-maximized=['<Super>m']
maximize=@as []
unmaximize=@as []
switch-to-workspace-left=@as []
switch-to-workspace-right=@as []
move-to-monitor-up=@as []
move-to-monitor-down=@as []
move-to-monitor-left=@as []
move-to-monitor-right=@as []

[org/gnome/mutter]
dynamic-workspaces=false
edge-tiling=true
workspaces-only-on-primary=false

[org/gnome/mutter/keybindings]
toggle-tiled-left=@as []
toggle-tiled-right=@as []

[org/gnome/shell]
disable-user-extensions=false
favorite-apps=['02os-install.desktop','org.gnome.Nautilus.desktop','firefox.desktop','org.gnome.Console.desktop','org.gnome.Settings.desktop']
enabled-extensions=['dash-to-dock@micxgx.gmail.com','pop-shell@system76.com']

[org/gnome/shell/keybindings]
toggle-message-tray=['<Super>v']

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
dock-fixed=true
extend-height=false
always-center-icons=true
dash-max-icon-size=48
icon-size-fixed=true
show-trash=true
show-mounts=true
show-favorites=true
show-show-apps-button=true
show-running=true
show-windows-preview=true
dance-urgent-applications=true
intellihide=false
autohide=false
animation-time=0.28
disable-overview-on-startup=true
apply-custom-theme=true
custom-theme-shrink=false
transparency-mode='DYNAMIC'
customize-alphas=true
min-alpha=0.35
max-alpha=0.85
running-indicator-style='DOTS'
unity-backlit-items=false
click-action='focus-minimize-or-previews'
hot-keys=false
isolate-workspaces=false
multi-monitor=false

[org/gnome/shell/extensions/pop-shell]
tile-by-default=false
gap-inner=4
gap-outer=4
active-hint=true
show-title=true
toggle-tiling=['<Super>y']

[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom1/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0]
name='Terminal'
command='kgx'
binding='<Super>t'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom1]
name='Files'
command='nautilus'
binding='<Super>f'

