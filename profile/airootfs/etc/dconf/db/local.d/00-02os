[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/02os/portal-halo.png'
picture-uri-dark='file:///usr/share/backgrounds/02os/portal-halo.png'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/02os/portal-halo.png'

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='adw-gtk3-dark'
icon-theme='02-OS'
cursor-theme='capitaine-cursors'
font-name='Inter 11'
enable-animations=true
clock-show-weekday=true

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'
num-workspaces=4

[org/gnome/desktop/wm/keybindings]
close=['<Super>q', '<Alt>F4']
minimize=['<Super>comma']
toggle-maximized=['<Super>m']
maximize=@as []
unmaximize=@as []
switch-to-workspace-left=@as []
switch-to-workspace-right=@as []
move-to-monitor-up=@as []
move-to-monitor-down=@as []
move-to-monitor-left=@as []
move-to-monitor-right=@as []

[org/gnome/mutter]
dynamic-workspaces=false
edge-tiling=true
workspaces-only-on-primary=false

[org/gnome/mutter/keybindings]
toggle-tiled-left=@as []
toggle-tiled-right=@as []

[org/gnome/shell]
disable-user-extensions=false
favorite-apps=['02os-install.desktop','org.gnome.Nautilus.desktop','firefox.desktop','org.gnome.Console.desktop','org.gnome.Settings.desktop']
enabled-extensions=['dash-to-dock@micxgx.gmail.com','pop-shell@system76.com','flourish@orsso.github.io','compiz-windows-effect@hermes83.github.com']

[org/gnome/shell/keybindings]
toggle-message-tray=['<Super>v']

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
dock-fixed=true
extend-height=false
always-center-icons=true
dash-max-icon-size=48
icon-size-fixed=true
show-trash=true
show-mounts=true
show-favorites=true
show-show-apps-button=true
show-running=true
show-windows-preview=true
dance-urgent-applications=true
intellihide=false
autohide=false
animation-time=0.28
disable-overview-on-startup=true
apply-custom-theme=true
custom-theme-shrink=false
transparency-mode='DYNAMIC'
customize-alphas=true
min-alpha=0.35
max-alpha=0.85
running-indicator-style='DOTS'
unity-backlit-items=false
click-action='focus-minimize-or-previews'
hot-keys=false
isolate-workspaces=false
multi-monitor=false

[org/gnome/shell/extensions/flourish]
motion-profile='custom'
custom-hover-enabled=true
custom-hover-scale=1.2
custom-hover-dynamic-spacing=true
custom-hover-lift=3
custom-hover-duration=160
custom-hover-easing='ease-out-cubic'
custom-neighbor-radius=2
custom-press-enabled=false
custom-launch-enabled=true
custom-launch-effect='bounce'
custom-launch-intensity=0.25
custom-launch-speed=0.8
custom-launch-repeat=false
custom-bounce-decay=0.0
custom-attention-enabled=true
custom-attention-effect='wiggle'
custom-attention-intensity=0.5
custom-attention-speed=1.0
custom-attention-cycles=1
custom-attention-interval=10
custom-attention-reminders=3
show-hover-background=true
show-focused-app-background=false
dock-outline='none'

[org/gnome/shell/extensions/com/github/hermes83/compiz-windows-effect]
preset='R'
friction=3.5
spring-k=3.8
speedup-factor-divider=12.0
mass=70.0
x-tiles=6.0
y-tiles=6.0
maximize-effect=false
resize-effect=false

[org/gnome/shell/extensions/pop-shell]
tile-by-default=false
gap-inner=4
gap-outer=4
active-hint=false
hint-color-rgba='rgba(0,0,0,0)'
show-title=true
toggle-tiling=['<Super>y']

[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom1/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0]
name='Terminal'
command='kgx'
binding='<Super>t'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom1]
name='Files'
command='nautilus'
binding='<Super>f'
