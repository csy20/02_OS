{
    "layer": "top",
    "position": "top",
    "height": 28,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 0,
    "modules-left": ["custom/logo", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["hyprland/workspaces", "pulseaudio", "network", "bluetooth", "battery", "custom/notifications"],

    "custom/logo": {
        "format": "  02_OS",
        "tooltip": false,
        "on-click": "02os-apple-menu"
    },

    "hyprland/window": {
        "max-length": 40,
        "separate-outputs": true,
        "rewrite": {
            "": "Desktop"
        }
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "1": "●",
            "2": "●",
            "3": "●",
            "4": "●",
            "default": "○"
        },
        "persistent-workspaces": {
            "*": [1, 2, 3, 4]
        }
    },

    "clock": {
        "interval": 1,
        "format": "{:%a %-d %b  %H:%M}",
        "tooltip-format": "{:%A, %-d %B %Y}"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", ""]
        },
        "tooltip-format": "Volume {volume}%",
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "",
        "format-disconnected": "󰖪",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-connected": "",
        "tooltip-format": "{status}",
        "on-click": "blueman-manager"
    },

    "battery": {
        "states": {
            "warning": 25,
            "critical": 10
        },
        "format": "{icon}",
        "format-charging": "",
        "format-plugged": "",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{capacity}%"
    },

    "custom/notifications": {
        "tooltip": false,
        "format": "",
        "on-click": "swaync-client -t -sw"
    }
}
