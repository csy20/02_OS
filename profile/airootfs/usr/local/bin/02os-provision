#!/usr/bin/env bash
# Copy the 02_OS allowlist from the live overlay into an installed system.
# Shared branding is included; live-only login setup, sudoers, sshd and users are not.
set -euo pipefail

usage() {
  echo "Usage: 02os-provision TARGET" >&2
  echo "       02os-provision --source DIR --target DIR" >&2
  exit 2
}

# 02OS_OVERLAY is not a valid shell identifier (it starts with a digit).
source_root="$(printenv 02OS_OVERLAY || true)"
if [[ -z "${source_root}" ]]; then
  source_root=/
fi
target=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --source)
      [[ $# -ge 2 ]] || usage
      source_root="$2"
      shift 2
      ;;
    --target)
      [[ $# -ge 2 ]] || usage
      target="$2"
      shift 2
      ;;
    --help|-h)
      usage
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "ERROR: unknown option $1" >&2
      usage
      ;;
    *)
      if [[ -n "${target}" ]]; then
        echo "ERROR: unexpected argument $1" >&2
        usage
      fi
      target="$1"
      shift
      ;;
  esac
done

if [[ -z "${target}" ]]; then
  usage
fi

if [[ ! -d "${source_root}" ]]; then
  echo "ERROR: source overlay is not a directory: ${source_root}" >&2
  exit 1
fi

source_canon="$(readlink -f -- "${source_root}")"
if ! target_canon="$(readlink -f -- "${target}")"; then
  echo "ERROR: target parent must already exist: ${target}" >&2
  exit 1
fi

# True when path is source_canon or a path under it. `/` contains every absolute path.
is_inside_root() {
  local root="$1" path="$2" prefix
  if [[ -z "${path}" ]]; then
    return 1
  fi
  if [[ "${root}" == "/" ]]; then
    [[ "${path}" == /* ]]
    return
  fi
  if [[ "${path}" == "${root}" ]]; then
    return 0
  fi
  prefix="${root}/"
  [[ "${path:0:${#prefix}}" == "${prefix}" ]]
}

assert_inside() {
  local path="$1" resolved=""
  if ! resolved="$(readlink -f -- "${path}")"; then
    echo "ERROR: refusing to copy unresolved symlink ${path}" >&2
    return 1
  fi
  if ! is_inside_root "${source_canon}" "${resolved}"; then
    echo "ERROR: refusing to copy ${path} (resolves to ${resolved} outside ${source_canon})" >&2
    return 1
  fi
}

# Missing required entries abort the install. Optional entries are skipped.
required=(
  usr/bin/02
  usr/bin/02-agentd
  usr/bin/02agent
  usr/lib/systemd/user/02-agentd.service
  etc/systemd/user/default.target.wants/02-agentd.service
  usr/local/bin/pop-launcher
  usr/share/gnome-shell/extensions/dash-to-dock@micxgx.gmail.com
  usr/share/gnome-shell/extensions/pop-shell@system76.com
  usr/share/gnome-shell/extensions/flourish@orsso.github.io
  usr/share/gnome-shell/extensions/compiz-windows-effect@hermes83.github.com
  usr/share/gnome-shell/extensions/02-zero-portal@02os
  usr/lib/tmpfiles.d/02os-zero-portal.conf
  usr/share/icons/02-OS
  usr/share/icons/hicolor/scalable/apps/02os-logo.svg
  usr/share/pixmaps/02os-logo.svg
  etc/os-release
  usr/share/backgrounds/02os
  usr/share/plymouth/themes/02-zero-portal
  etc/plymouth/plymouthd.conf
  usr/share/glib-2.0/schemas/org.gnome.shell.extensions.dash-to-dock.gschema.xml
  usr/share/glib-2.0/schemas/org.gnome.shell.extensions.pop-shell.gschema.xml
  usr/share/glib-2.0/schemas/org.gnome.shell.extensions.flourish.gschema.xml
  usr/share/glib-2.0/schemas/org.gnome.shell.extensions.com.github.hermes83.compiz-windows-effect.gschema.xml
  etc/dconf/db/local.d/00-02os
  etc/dconf/profile/user
  etc/dconf/db/local
  etc/dconf/profile/gdm
  etc/dconf/db/gdm.d/00-02os-branding
  etc/dconf/db/gdm
)

optional=(
  usr/local/bin/pop-shell-shortcuts
  usr/local/bin/02os-install
  usr/local/bin/02os-provision
  usr/share/applications/02os-install.desktop
  usr/lib/02-agent
)

copy_entry() {
  local rel="$1"
  local src="${source_canon}/${rel}"
  local dest="${target_canon}/${rel}"
  local link=""
  if [[ ! -e "${src}" && ! -L "${src}" ]]; then
    echo "WARNING: skipping missing ${rel}" >&2
    return 0
  fi
  assert_inside "${src}"
  if [[ -d "${src}" && ! -L "${src}" ]]; then
    while IFS= read -r -d '' link; do
      assert_inside "${link}"
    done < <(find "${src}" -type l -print0)
    mkdir -p -- "${dest}"
    cp -a -- "${src}/." "${dest}/"
  else
    mkdir -p -- "$(dirname -- "${dest}")"
    if [[ "${rel}" == "etc/os-release" ]]; then
      # The base system ships /etc/os-release as a symlink to its vendor file.
      # Replace both paths so neither one still names another operating system.
      local vendor="${target_canon}/usr/lib/os-release"
      [[ ! -d "${dest}" ]] || { echo "ERROR: ${dest} is a directory" >&2; return 1; }
      [[ ! -d "${vendor}" ]] || { echo "ERROR: ${vendor} is a directory" >&2; return 1; }
      mkdir -p -- "$(dirname -- "${vendor}")"
      cp -a --remove-destination -- "${src}" "${dest}"
      cp -a --remove-destination -- "${src}" "${vendor}"
    else
      cp -a -- "${src}" "${dest}"
    fi
  fi
}

require_entry() {
  local rel="$1"
  local src="${source_canon}/${rel}"
  if [[ ! -e "${src}" && ! -L "${src}" ]]; then
    echo "ERROR: required 02_OS file is missing from the live system: ${rel}" >&2
    echo "Refusing to leave an unprovisioned target without the 02 desktop, agent, daemon, and branding." >&2
    exit 1
  fi
}

# The live image keeps Install 02_OS. The installed system does not get a
# desktop entry whose Exec needs archinstall_plugin.py unless that plugin
# is already on the target (this allowlist does not copy it).
launcher_needs_missing_plugin() {
  local rel="$1"
  local src="${source_canon}/${rel}"
  local exec_line plugin_rel
  [[ "${rel}" == usr/share/applications/*.desktop ]] || return 1
  [[ -f "${src}" && ! -L "${src}" ]] || return 1
  exec_line="$(grep -E '^Exec=' -- "${src}" || true)"
  [[ -n "${exec_line}" ]] || return 1
  plugin_rel="usr/local/share/02os/archinstall_plugin.py"
  if [[ "${exec_line}" != *"02os-install"* && "${exec_line}" != *"archinstall_plugin.py"* ]]; then
    return 1
  fi
  if [[ -e "${target_canon}/${plugin_rel}" || -L "${target_canon}/${plugin_rel}" ]]; then
    return 1
  fi
  return 0
}

compile_installed_dconf() {
  local db="${target_canon}/etc/dconf/db/local"
  local keys="${target_canon}/etc/dconf/db/local.d"
  if ! command -v dconf >/dev/null 2>&1; then
    echo "ERROR: dconf is required to update installed desktop defaults" >&2
    exit 1
  fi
  dconf compile "${db}" "${keys}"
}

# Drop the live installer favorite after the keyfile is copied. The compiled
# system db is rewritten so the installed session does not keep the old value.
strip_installer_favorite() {
  local keyfile="${target_canon}/etc/dconf/db/local.d/00-02os"
  local result
  [[ -f "${keyfile}" && ! -L "${keyfile}" ]] || return 0
  if ! grep -q '02os-install.desktop' -- "${keyfile}"; then
    return 0
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    echo "ERROR: python3 is required to update installed desktop favorites" >&2
    exit 1
  fi
  result="$(python3 - "${keyfile}" <<'PY'
import pathlib, re, sys
path = pathlib.Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
pattern = re.compile(r"favorite-apps=\[([^\]]*)\]")

def repl(match):
    items = [part.strip() for part in match.group(1).split(",") if part.strip()]
    kept = [part for part in items if part != "'02os-install.desktop'"]
    if not kept:
        return "favorite-apps=@as []"
    return "favorite-apps=[" + ",".join(kept) + "]"

updated, count = pattern.subn(repl, text)
if count == 0 or updated == text:
    print("unchanged")
else:
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(updated, encoding="utf-8")
    tmp.replace(path)
    print("changed")
PY
)"
  if [[ "${result}" == "changed" ]]; then
    compile_installed_dconf
  else
    echo "ERROR: ${keyfile} still references 02os-install.desktop" >&2
    exit 1
  fi
}

mkdir -p -- "${target_canon}"
echo "02os-provision: ${source_canon} -> ${target_canon}"

for rel in "${required[@]}"; do
  require_entry "${rel}"
done

for rel in "${required[@]}" "${optional[@]}"; do
  if launcher_needs_missing_plugin "${rel}"; then
    echo "02os-provision: not installing ${rel}; archinstall plugin is not on the target" >&2
    continue
  fi
  copy_entry "${rel}"
done

strip_installer_favorite

schema_dir="${target_canon}/usr/share/glib-2.0/schemas"
if [[ ! -d "${schema_dir}" ]]; then
  echo "ERROR: ${schema_dir} is missing after copying the 02 desktop profile." >&2
  exit 1
fi
if ! command -v glib-compile-schemas >/dev/null 2>&1; then
  echo "ERROR: glib-compile-schemas is required to install the 02 desktop profile." >&2
  exit 1
fi
glib-compile-schemas --strict "${schema_dir}"
while IFS= read -r -d '' extension_schemas; do
  glib-compile-schemas --strict "${extension_schemas}"
done < <(find "${target_canon}/usr/share/gnome-shell/extensions" -type d -name schemas -print0)

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
  for theme_name in 02-OS hicolor; do
    icon_theme="${target_canon}/usr/share/icons/${theme_name}"
    if [[ -f "${icon_theme}/index.theme" ]]; then
      gtk-update-icon-cache -q -t -f "${icon_theme}" || true
    fi
  done
fi
