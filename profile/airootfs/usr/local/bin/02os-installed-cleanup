#!/usr/bin/env bash
# Run inside the installed system by Calamares (chrooted).
# Drop live-USB autologin / passwordless sudo after unpackfs.
set -u

userdel -r live 2>/dev/null || true
rm -f /etc/sudoers.d/01-live

cat > /etc/greetd/config.toml << 'EOF'
[terminal]
vt = 1

[default_session]
command = "agreety --cmd 'uwsm start hyprland-uwsm.desktop'"
user = "greetd"
EOF

cat > /etc/sudoers.d/10-wheel << 'EOF'
Defaults lecture = never
%wheel ALL=(ALL:ALL) ALL
EOF
chmod 440 /etc/sudoers.d/10-wheel

exit 0
