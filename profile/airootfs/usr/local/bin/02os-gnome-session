#!/usr/bin/env bash
# GNOME 50 session leader. Do not wrap in dbus-run-session: gnome-session
# talks to the systemd --user bus that greetd/PAM already started.
set -uo pipefail

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=GNOME
export XDG_SESSION_DESKTOP=gnome
export XDG_SESSION_CLASS=user
export GDK_BACKEND=wayland
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland
export XDG_MENU_PREFIX=gnome-

if ! compgen -G '/dev/dri/card*' >/dev/null 2>&1; then
  export LIBGL_ALWAYS_SOFTWARE=1
  export GALLIUM_DRIVER=llvmpipe
fi

# Propagate session environment to systemd --user and D-Bus activation environments
systemctl --user import-environment \
  LIBGL_ALWAYS_SOFTWARE GALLIUM_DRIVER \
  MOZ_ENABLE_WAYLAND QT_QPA_PLATFORM \
  XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE 2>/dev/null || true
dbus-update-activation-environment --systemd --all 2>/dev/null || true

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
log_file="${runtime_dir}/02os-gnome-session.log"
count_file="${runtime_dir}/02os-gnome-session.failures"
umask 022
touch "${log_file}"
chmod 644 "${log_file}" 2>/dev/null || true

failures=0
if [[ -f "${count_file}" ]]; then
  failures="$(tr -cd '0-9' < "${count_file}")"
  failures="${failures:-0}"
fi
if [[ "${failures}" -ge 3 ]]; then
  echo 0 > "${count_file}"
  echo "$(date -Is) falling back to agreety after ${failures} gnome-session failures" >> "${log_file}"
  exec agreety --cmd /usr/local/bin/02os-gnome-session
fi

/usr/bin/gnome-session
status=$?
echo "$(date -Is) gnome-session exited ${status}" >> "${log_file}"
if [[ "${status}" -eq 0 ]]; then
  echo 0 > "${count_file}"
else
  echo $((failures + 1)) > "${count_file}"
fi
exit "${status}"
