#!/usr/bin/env bash
# Live-session entry point. archinstall custom commands cannot see the ISO,
# so provisioning happens from the host plugin after the base system is strapped.
set -euo pipefail

cat <<'EOF'
Install 02_OS

Choose the GNOME desktop profile when the installer asks which desktop to install.
Partitioning, user account, and bootloader prompts still run.
After the base system is installed, and again after the desktop packages
are installed, the 02_OS provisioner copies the 02 desktop profile, agent
binaries, user daemon, and branding into the new system.
EOF

if [[ "$(id -u)" -ne 0 ]]; then
  exec sudo -- archinstall --plugin /usr/local/share/02os/archinstall_plugin.py --skip-version-check "$@"
fi
exec archinstall --plugin /usr/local/share/02os/archinstall_plugin.py --skip-version-check "$@"
