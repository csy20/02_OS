# Native logo stage for Zero Portal; the live reveal runs in the GDM compositor.
# duration in the progress callback is Plymouth's real elapsed boot time.
# Refresh ticks never advance this timeline, so slow rendering cannot stretch it.
Window.SetBackgroundTopColor(249 / 255, 249 / 255, 247 / 255);
Window.SetBackgroundBottomColor(249 / 255, 249 / 255, 247 / 255);
Plymouth.SetRefreshRate(30);

global.intro_duration = 0.25;
global.epoch = -1;
global.elapsed = 0;
global.boot_mode = Plymouth.GetMode() == "boot";
global.finished = !global.boot_mode;
global.prompt_active = 0;
global.last_frame = -2;
global.screen_width = 0;
global.screen_height = 0;
global.message_text = "";
global.prompt_text = "";
global.entry_text = "";

global.logo_image = Image("logo.png");
global.logo_sprite = Sprite();
global.prompt_sprite = Sprite();
global.entry_sprite = Sprite();
global.message_sprite = Sprite();
logo_sprite.SetZ(2);
prompt_sprite.SetZ(10);
entry_sprite.SetZ(10);
message_sprite.SetZ(10);
prompt_sprite.SetOpacity(0);
entry_sprite.SetOpacity(0);
message_sprite.SetOpacity(0);

fun smooth(value)
{
    value = Math.Clamp(value, 0, 1);
    return value * value * (3 - 2 * value);
}

fun place_text(sprite, text, y)
{
    if (text == "")
    {
        sprite.SetOpacity(0);
        return;
    }
    image = Image.Text(text, 0.125, 0.13, 0.14, 1, "Sans 14", "center");
    if (image.GetWidth() > global.screen_width - 48)
    {
        ratio = (global.screen_width - 48) / image.GetWidth();
        image = image.Scale(image.GetWidth() * ratio, image.GetHeight() * ratio);
    }
    sprite.SetImage(image);
    sprite.SetPosition(Window.GetX() + (global.screen_width - image.GetWidth()) / 2,
                       Window.GetY() + y, 10);
    sprite.SetOpacity(1);
}

fun layout()
{
    global.screen_width = Math.Max(64, Window.GetWidth());
    global.screen_height = Math.Max(64, Window.GetHeight());
    # Match the approved preview on a wide screen; fit shorter displays too.
    global.canvas_width = Math.Int(Math.Min(global.screen_width * 0.4,
                                            global.screen_height * 0.66 * 512 / 448));
    global.canvas_width = Math.Max(1, global.canvas_width);
    global.canvas_height = Math.Max(1, Math.Int(global.canvas_width * 448 / 512));
    global.center_x = Window.GetX() + global.screen_width / 2;
    global.center_y = Window.GetY() + global.screen_height / 2;
    global.last_frame = -2;
        place_text(prompt_sprite, global.prompt_text, global.screen_height * 0.77);
    place_text(entry_sprite, global.entry_text, global.screen_height * 0.77 + 34);
    place_text(message_sprite, global.message_text, global.screen_height - 56);
}

fun show_logo()
{
    if (global.last_frame != -1)
    {
        image = global.logo_image.Scale(global.canvas_width, global.canvas_height);
        logo_sprite.SetImage(image);
        logo_sprite.SetPosition(global.center_x - global.canvas_width / 2,
                                global.center_y - global.canvas_height / 2, 2);
        global.last_frame = -1;
    }
}

fun refresh()
{
    if (Window.GetWidth() != global.screen_width || Window.GetHeight() != global.screen_height)
        layout();
    show_logo();
    if (global.finished || global.prompt_active || !global.boot_mode)
        logo_sprite.SetOpacity(1);
    else
        logo_sprite.SetOpacity(smooth(global.elapsed / global.intro_duration));
}

fun boot_progress(duration, progress)
{
    if (!global.boot_mode || global.finished)
        return;
    if (global.epoch < 0)
        global.epoch = duration;
    global.elapsed = Math.Max(global.elapsed, duration - global.epoch);
    if (global.elapsed >= global.intro_duration)
        global.finished = 1;
    refresh();
}

fun display_normal()
{
    global.prompt_active = 0;
    global.prompt_text = "";
    global.entry_text = "";
    prompt_sprite.SetOpacity(0);
    entry_sprite.SetOpacity(0);
    refresh();
}

fun display_password(prompt, bullets)
{
    global.prompt_active = 1;
    # A real input request takes priority and settles the intro permanently.
    global.finished = 1;
    global.prompt_text = prompt;
    global.entry_text = "";
    for (index = 0; index < Math.Min(bullets, 64); index++)
        global.entry_text += "•";
    if (bullets == 0)
        global.entry_text = "_";
    layout();
    refresh();
}

fun display_question(prompt, entry)
{
    global.prompt_active = 1;
    global.finished = 1;
    global.prompt_text = prompt;
    global.entry_text = entry + "_";
    layout();
    refresh();
}

fun display_prompt(prompt, entry, is_secret)
{
    if (is_secret)
        display_password(prompt, entry.Length());
    else
        display_question(prompt, entry);
}

fun display_message(message)
{
    global.message_text = message;
    place_text(message_sprite, message, global.screen_height - 56);
}

fun hide_message(message)
{
    if (message == global.message_text)
    {
        global.message_text = "";
        message_sprite.SetOpacity(0);
    }
}

fun quit()
{
    # Stock script themes stop refreshing immediately after this callback.
    # Preserve a clean final logo for a retained-splash display-manager handoff.
    global.finished = 1;
    global.prompt_active = 0;
    prompt_sprite.SetOpacity(0);
    entry_sprite.SetOpacity(0);
    message_sprite.SetOpacity(0);
    refresh();
}

Plymouth.SetRefreshFunction(refresh);
Plymouth.SetBootProgressFunction(boot_progress);
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayQuestionFunction(display_question);
Plymouth.SetDisplayPromptFunction(display_prompt);
Plymouth.SetDisplayMessageFunction(display_message);
Plymouth.SetHideMessageFunction(hide_message);
Plymouth.SetQuitFunction(quit);
Plymouth.SetDisplayHotplugFunction(layout);
layout();
refresh();
