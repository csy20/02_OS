[Unit]
Description=02 Agent Runtime Daemon (Repository Intelligence & MCP Service)
Documentation=https://github.com/csy20/02_OS
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/02-agentd
Restart=on-failure
RestartSec=3s
Environment=RUST_LOG=info

# ProtectHome=no leaves home writable so repositories there can be indexed.
# The data directory is still created mode 0700. A leading '-' keeps the
# first start from failing when those paths do not exist yet.
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=-%h/.local/share/02-agent -%h/.cache/02-agent -%t
NoNewPrivileges=true

[Install]
WantedBy=default.target
