[Unit]
Description=02 Agent Runtime Daemon (Repository Intelligence & MCP Service)
Documentation=https://github.com/csy20/02_OS
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/02-agentd
Restart=on-failure
RestartSec=3s
Environment=RUST_LOG=info

# User-level protection. Home stays writable because the daemon indexes
# repositories that live under the user's home directory. The data directory
# itself is created mode 0700.
ProtectSystem=strict
ProtectHome=read-write
ReadWritePaths=%h/.local/share/02-agent %h/.cache/02-agent %t
NoNewPrivileges=true

[Install]
WantedBy=default.target
